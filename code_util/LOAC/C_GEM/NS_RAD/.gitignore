# ---- NS-RAD .gitignore ----

# Model run outputs (regenerable via tools/build_all.sh; large, ~GB)
runs/

# Build artifacts: NOTHING generated by tools/build_all.sh is tracked. The combined
# report is ~32 MB and the movies ~2 MB, and both are fully reproducible from a model
# run, so keeping them in history would bloat every clone for no benefit. Rebuild with
# `tools/build_all.sh --figures-only` (which recreates the six part-PDFs, stitches them
# into the report, then removes them), not `make_report.py` alone.
docs/ns_rad_model_summary.pdf
docs/ns_rad_model_schematic.pdf
docs/ns_rad_geometry.pdf
docs/ns_rad_river_networks.pdf
docs/ns_rad_diagnostics.pdf
docs/ns_rad_validation.pdf
docs/ns_rad_report.pdf
docs/idealized_verification.pdf
docs/NS-RAD_running_instructions.docx
docs/movies/

# Legacy per-field text outputs (NetCDF is the default; .dat are transient)
*.dat

# Python / Numba caches
__pycache__/
*.py[cod]
*.nbc
*.nbi
.ipynb_checkpoints/

# OS / editor / IDE
.DS_Store
.idea/
*.swp
*~

# Claude Code workspace (not project content)
.claude/

# Scratch
*.tmp
scratch/

# Raw download caches for the interannual forcing builders (tools/build_interannual_*.py)
# -- large (multi-GB), fully reproducible by rerunning the script; only the derived
# forcing/*.csv outputs are tracked. Wildcarded (not listed one-by-one) since each new
# source this project adds gets its own forcing/_<source>_cache/ directory.
forcing/_*_cache/

# Green's-function perturbation scratch (tools/build_green_perturbations.py) --
# auto-generated perturbed forcing copies and one-override site variants, fully
# reproducible by rerunning that script; not meant to be hand-edited or committed.
forcing/_green_scratch/
code/sites/_green_*.py

# Same, for the FORTE-campaign-framework counterpart (tools/build_green_perturbations_
# forte.py) -- 25 controls x 3 sites of auto-generated one-override site variants (plus
# the 3 shared lateral-baseline variants), fully reproducible by rerunning that script.
forcing/_fortegreen_scratch/
code/sites/_fortegreen_*.py

# Large, fully-regenerable synthetic-observation CSVs (tools/build_osse_observations*.py)
# -- continuous-sensor channels (moorings/airborne/drifters) run tens of MB per river;
# the small grab/satellite CSVs and the small observation_value_ranking*.csv RESULTS
# stay tracked, since those are the actual analysis deliverables, not raw synthetic data.
docs/osse*/*_moorings.csv
docs/osse*/*_airborne.csv
docs/osse*/*_drifters.csv

# Per-session launch logs (tools/run_*.sh / ad-hoc background launches) -- transient
# process output, not source and not a tracked result.
tools/.*.log
