# sediment_mudflat: passive tracers 1 = river water (relaxed to 1 at
# the river cell by pkg/rbcs), 2 = water over the mudflat at t=0, and two
# sediment classes carried by pkg/sediment (kg/m^3): 3 = mud, 4 = fine sand
 &PTRACERS_PARM01
 PTRACERS_numInUse=4,
 PTRACERS_Iter0=0,
 PTRACERS_advScheme(1:4)=4*33,
 PTRACERS_diffKh(1:4)=4*0.,
 PTRACERS_diffKr(1:4)=4*1.E-5,
 PTRACERS_useKPP(1:4)=4*.TRUE.,
 PTRACERS_initialFile(1)='ptr1.bin',
 PTRACERS_initialFile(2)='ptr2.bin',
 PTRACERS_names(1)='river',
 PTRACERS_names(2)='flatwater',
 PTRACERS_names(3)='mud',
 PTRACERS_names(4)='sand',
 PTRACERS_units(3)='kg/m^3',
 PTRACERS_units(4)='kg/m^3',
 &
