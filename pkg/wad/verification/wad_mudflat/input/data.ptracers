# passive tracers: 1 = river water (relaxed to 1 at the river cell by
# pkg/rbcs), 2 = water over the mudflat at t=0
 &PTRACERS_PARM01
 PTRACERS_numInUse=2,
 PTRACERS_Iter0=0,
 PTRACERS_advScheme(1:2)=2*33,
 PTRACERS_diffKh(1:2)=2*0.,
 PTRACERS_diffKr(1:2)=2*1.E-5,
 PTRACERS_useKPP(1:2)=2*.TRUE.,
 PTRACERS_initialFile(1)='ptr1.bin',
 PTRACERS_initialFile(2)='ptr2.bin',
 PTRACERS_names(1)='river',
 PTRACERS_names(2)='flatwater',
 &
