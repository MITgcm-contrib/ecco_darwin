 a_R_PICPOC(:) = 2*4.19E-2,1*0.05,3*4.19E-2,

 a_Xmin(:)= 6*120E-20,

 a_phytoTempAe=0.0758, 0.0635, 0.0353, 0.0575, 0.0438, 0.0512,

 a_mQyield(:)= 6*4E-5,
 a_chl2cmax(:)=  4*.2, .3, .2,
 a_acclimtimescl(:)= 6*5.7870370370370370E-6,
 logvolbase= -1.4130,
