# v06 3deg data.darwin -- derived from v06/1deg/input_darwin_v4r5_v2/data.darwin
#
# 3deg-specific changes vs v06/1deg:
#   * riverine BGC (LOAC) block commented out; DARWIN_NUTRIENT_RUNOFF is #undef
#     in code/DARWIN_OPTIONS.h (no 128x64 LOAC fields exist).
#   * darwin_chlIter0 2 -> 0 (3deg cold-starts at nIter0=0, no darwin pickup).
#
# Everything else is grid-independent: ironFile (144x96), ventHe3File (128x64)
# and pCO2File (2x256) are all read on their native lat-lon grids and
# interpolated onto the model grid by pkg/darwin, so no regridding is needed.
#
# Standalone fallback (no NAS access): to use the 3deg climatology that ships
# with v05/3deg/data_darwin instead of NOAA MBL apCO2, replace the pCO2 block
# with:
#     pCO2File = 'apCO2_2000',
#     pCO2period = -12.,
#   and in DARWIN_INTERP_PARAMS:
#     pCO2_lon0 = -178.5, pCO2_lon_inc = 3.0,
#     pCO2_lat0 = -88.5,  pCO2_lat_inc = 59*3.0,
#     pCO2_nlon = 120,    pCO2_nlat = 60,
#
 &DARWIN_FORCING_PARAMS
# Iron deposition: Hamilton et al. (2020) CESM-MIMI soluble Fe.
# File is real*4, 144x96 lat-lon, 12 monthly records (hence ironPeriod=-12),
# in units of kg Fe m^-2 s^-1.
#
# darwin_inscal_iron converts the file to the mmol Fe m^-2 s^-1 that
# pkg/darwin expects. From darwin_forcing.F:
#     gPtr(iFeT) += alpfe * inputFe * recip_drF(1) * recip_hFacC(1)
# gPtr(iFeT) is mmol Fe m^-3 s^-1 and recip_drF is m^-1, so inputFe must be
# mmol Fe m^-2 s^-1, and inputFe = darwin_inscal_iron * (file value). Hence
#     darwin_inscal_iron = 1000 [mmol/mol] / 0.055845 [kg/mol] = 17906.70606142
# Do not "round" this -- it is 1000/M_Fe exactly.
#
# For reference, v05 used llc90_Mahowald_2009_soluble_iron_dust.bin with
# darwin_inscal_iron=1000 because that file is in mol Fe m^-2 s^-1. The two
# files are NOT interchangeable at a common scale factor.
 ironFile = 'CESM-MIMI_1980-2015_CAM4-6MEAN_MonthlyDep_Hamiltonetal2020_kgFem2s_clim1980-2015.R4_144x96x12.bin',
 ironPeriod = -12,
 darwin_inscal_iron = 17906.70606142,
#
 pCO2File = 'apCO2',
 pCO2startdate1 = 19920101,
 pCO2startdate2 = 000000,
 pCO2period     = 86400.0,
#
 ventHe3File = 'mitgcm_3he_flux.bin',
 ventHe3Period = -12.,
 darwin_inscal_ventHe3 = 1000.,
#
#  DOCrunofffile = 'DOC_ECCO_V4r5',
#  DOCrunoffstartdate1 = 19920101,
#  DOCrunoffstartdate2 = 120000,
#  DOCrunoffperiod     = 86400.0,
#  darwin_inscal_DOCrunoff = 1,
#
#  DONrunofffile = 'DON_ECCO_V4r5',
#  DONrunoffstartdate1 = 19920101,
#  DONrunoffstartdate2 = 120000,
#  DONrunoffperiod     = 86400.0,
#  darwin_inscal_DONrunoff = 1,
#
#  DOPrunofffile = 'DOP_ECCO_V4r5',
#  DOPrunoffstartdate1 = 19920101,
#  DOPrunoffstartdate2 = 120000,
#  DOPrunoffperiod     = 86400.0,
#  R_DOFe_DOP_runoff   = 3E-4,
#  darwin_inscal_DOPrunoff = 1,
#
#  DINrunofffile = 'DIN_ECCO_V4r5',
#  DINrunoffstartdate1 = 19920101,
#  DINrunoffstartdate2 = 120000,
#  DINrunoffperiod     = 86400.0,
#  R_NO3_DIN_runoff    = 0.6531,
#  R_NO2_DIN_runoff    = 0.0158,
#  R_NH4_DIN_runoff    = 0.3311,
#  darwin_inscal_DINrunoff = 1,
#
#  IPrunofffile = 'DIP_ECCO_V4r5',
#  IPrunoffstartdate1 = 19920101,
#  IPrunoffstartdate2 = 120000,
#  IPrunoffperiod     = 86400.0,
#  R_DFe_DIP_runoff   = 3E-4,
#  R_DIP_IP_runoff    = 0.25,
#  darwin_inscal_IPrunoff = 1,
#
#  DSirunofffile = 'DSi_ECCO_V4r5',
#  DSirunoffstartdate1 = 19920101,
#  DSirunoffstartdate2 = 120000,
#  DSirunoffperiod     = 86400.0,
#  darwin_inscal_DSirunoff = 1,
#
#  POCrunofffile = 'POC_ECCO_V4r5',
#  POCrunoffstartdate1 = 19920101,
#  POCrunoffstartdate2 = 120000,
#  POCrunoffperiod     = 86400.0,
#  darwin_inscal_POCrunoff = 1,
#
#  POPrunofffile = 'PP_ECCO_V4r5',
#  POPrunoffstartdate1 = 19920101,
#  POPrunoffstartdate2 = 120000,
#  POPrunoffperiod     = 86400.0,
#  R_POFe_POP_runoff   = 3E-4,
#  darwin_inscal_POPrunoff = 1,
#
#  PONrunofffile = 'PN_ECCO_V4r5',
#  PONrunoffstartdate1 = 19920101,
#  PONrunoffstartdate2 = 120000,
#  PONrunoffperiod     = 86400.0,
#  darwin_inscal_PONrunoff = 1,
#
#  DICrunofffile = 'DIC_ECCO_V4r5',
#  DICrunoffstartdate1 = 19920101,
#  DICrunoffstartdate2 = 120000,
#  DICrunoffperiod     = 86400.0,
#  R_ALK_DIC_runoff    = 0.9886,
#  darwin_inscal_DICrunoff = 1,
#
 darwin_useEXFwind = .TRUE.,
 darwin_useQsw = .TRUE.,
 darwin_useSEAICE = .TRUE.,
 /
 &DARWIN_INTERP_PARAMS
# DOCrunoff_interpMethod = 0,
# DONrunoff_interpMethod = 0,
# DOPrunoff_interpMethod = 0,
# DINrunoff_interpMethod = 0,
# IPrunoff_interpMethod = 0,
# DSirunoff_interpMethod = 0,
# DOPrunoff_interpMethod = 0,
# POCrunoff_interpMethod = 0,
# POPrunoff_interpMethod = 0,
# PONrunoff_interpMethod = 0,
# DICrunoff_interpMethod = 0,

# Note: this source grid (lon 1.40625 + n*2.8125, lat -88.59375 + n*2.8125)
# is exactly the 3deg model grid, so the interpolation is an identity map.
# Left on the default interpMethod=1 rather than forced to 0, since 0 would
# depend on the file's on-disk layout matching the model grid exactly.
 ventHe3_lon0    = 1.40625,
 ventHe3_lon_inc = 2.8125,
 ventHe3_lat0    = -88.59375,
 ventHe3_lat_inc = 63*2.8125,
 ventHe3_nlon    = 128,
 ventHe3_nlat    = 64,

# MUST be >=1: the dust file is on a 144x96 source grid, not the model grid.
# v05/3deg sets iron_interpMethod=0 because its dust file was already on the
# 128x64 grid. With interp_method=0, exf_set_fld calls READ_REC_3D_RL and
# reads the file straight in as model-grid data -- it would consume 128*64
# values out of a 144*96 record and silently produce garbage. Set explicitly
# rather than relying on the default.
 iron_interpMethod = 1,
#
 iron_lon0    = 0.,
 iron_lon_inc = 2.5,
 iron_lat0    = -90.,
 iron_lat_inc = 95*1.894736842105263,
 iron_nlon    = 144,
 iron_nlat    = 96,
#
 pCO2_lon0    = 0.0D0,
 pCO2_lon_inc = 360.0D0,
 pCO2_lat0    = -89.4628220D0,
 pCO2_lat_inc = 0.6958694,0.6999817,0.7009048,0.7012634,0.7014313,
                245*0.7017418,
                0.7014313,0.7012634,0.7009048,0.6999817,0.6958694
 pCO2_nlon    = 2,
 pCO2_nlat    = 256,
 /
 &DARWIN_PARAMS
 darwin_chlIter0=0
 darwin_pickupSuff= ' ',
# selectPHsolver=1,
# selectK1K2const=5,
 darwin_chlInitBalanced= T,
 diaz_ini_fac= 0.1,
 darwin_seed= 56,
 tempCoeffArr= 1.0,
 PARmin= 0.1,
 alpfe= 1.0,
 freefemax = .1E-3,
 depthfesed= 7000.,
 scav_tau= 1.0,
 ligand_tot= 1e-3,
 scav_POC_wgt=0.06,
 scav_PSi_wgt = 0.,
 scav_PIC_wgt = 0.,
 kdoc=  2.314814814814815E-7,   ! 1/50day
 kdop=  2.314814814814815E-7,   ! 1/50day
 kdon=  2.314814814814815E-7,   ! 1/50day
 kdofe= 2.314814814814815E-7,   ! 1/50day
 kPOC=  2.314814814814815E-7,   ! 1/50day
 kPOP=  3.8580246913580247E-7,  ! 1/30day
 kPON=  3.8580246913580247E-7,  ! 1/30day
 kPOFe= 3.8580246913580247E-7,  ! 1/30day
 kPOSi= 7.716049382716049E-8,   ! 1/150day
 phygrazmin= 120E-10,
 hollexp = 1.E0,
 wC_sink=0.00011574074074074075,
 wN_sink=0.00011574074074074075,
 wP_sink=0.00011574074074074075,
 wFe_sink=0.00011574074074074075,
 wSi_sink=0.00011574074074074075,
 wPIC_sink=0.00017361111111111111,
 SURFDICMIN  =   100.0,
 SURFALKMIN  =   100.0,
 darwin_disscSelect = 2,
 /
########################
 &DARWIN_CDOM_PARAMS
  fracCDOM = 0.02,
  cdomdegrd= 3.8580e-08,
  CDOMbleach = 1.9329e-06,
  PARCDOM = 60.,
#  R_NP_CDOM  = 16.,
#  R_FeP_CDOM = 1.e-3,
#  R_CP_CDOM  = 120.,
   CDOMcoeff = 0.1750000,
 /
 &DARWIN_RADTRANS_PARAMS
 darwin_waterabsorbFile='OPTICS_COEFF2/optics_water.txt',
 darwin_phytoabsorbFile='OPTICS_COEFF2/optics_plankton.txt',
 darwin_particleabsorbFile='OPTICS_COEFF2/optics_detritus.txt',
 darwin_Sdom=0.0145000,
 darwin_aCDOM_fac = 0.30,
 darwin_part_size_P = 1e-15,
 darwin_rCDOM = 1.0e-4,
 darwin_RPOC = 2.0,

 darwin_allomSpectra= T,
 darwin_absorpSlope= -0.075,
 darwin_bbbSlope=    -1.458,
 darwin_scatSwitchSizeLog= 2.860959e-01, 2.923177e-01, 2.983251e-01, 3.140574e-01, 3.261153e-01,
                           3.440134e-01, 3.577670e-01, 3.618763e-01, 3.695100e-01, 3.718916e-01,
                           3.706202e-01, 3.640583e-01, 3.682107e-01,
 darwin_scatSlopeSmall= 4.185404e+00, 4.208007e+00, 4.261307e+00, 4.302451e+00, 4.341968e+00,
                        4.373109e+00, 4.392320e+00, 4.416705e+00, 4.434653e+00, 4.454953e+00,
                        4.479809e+00, 4.507577e+00, 4.544071e+00,
 darwin_scatSlopeLarge= 1.723153e+00, 1.718186e+00, 1.699666e+00, 1.687533e+00, 1.710736e+00,
                        1.732242e+00, 1.763117e+00, 1.811451e+00, 1.834619e+00, 1.863836e+00,
                        1.897289e+00, 1.861866e+00, 1.907367e+00,
 /
########################
 &DARWIN_RANDOM_PARAMS
 /
