# v06 3deg data.ptracers -- 36 tracers (v05/3deg had 31)
#
# Tracer layout follows v06 exactly:
#   1-19  DIC..O2          identical to v05
#   20    CDOM             NEW in v06 (DARWIN_ALLOW_CDOM)
#   21-30 c01..c10         6 phyto + 4 zoo  (v05 had 20-26 = c01..c07: 5 phyto + 2 zoo)
#   31-36 Chl01..Chl06     (v05 had 27-31 = Chl01..Chl05)
#
# v06 plankton groups (from data.traits grp_names / grp_nplank):
#   c01 PicoCyano  c02 PicoEuk  c03 Cocco  c04 Diazo  c05 Diatom  c06 Dino
#   c07-c10 Zoo (4 size classes)
#
# NOTE: v05 and v06 plankton indices are NOT the same organisms. Do not copy
# v05 c01..c07 into v06 c01..c07. Initial files below are built by
# matlab/make_v06_3deg_initial_conditions.m -- see that script for the mapping.
#
# Chl01..Chl06 are intentionally left blank: darwin_chlInitBalanced=T in
# data.darwin computes chlorophyll from biomass at darwin_chlIter0.
#
 &PTRACERS_PARM01
 PTRACERS_numInUse= 36,
 PTRACERS_Iter0= 0,
#
 PTRACERS_advScheme(:)= 36*33,
 PTRACERS_diffKh(:)= 36*0.E3,
 PTRACERS_diffKr(:)= 36*1.E-5,
 PTRACERS_useGMRedi(:)= 36*.TRUE.,
#
 PTRACERS_EvPrRn(:)= 36*0.E3,
#
 PTRACERS_names( 1)= 'DIC',
 PTRACERS_initialFile( 1)='ptracers_v06_3deg_01.0000000001',

 PTRACERS_names( 2)= 'NO3',
 PTRACERS_initialFile( 2)='ptracers_v06_3deg_02.0000000001',

 PTRACERS_names( 3)= 'NO2',
 PTRACERS_initialFile( 3)='ptracers_v06_3deg_03.0000000001',

 PTRACERS_names( 4)= 'NH4',
 PTRACERS_initialFile( 4)='ptracers_v06_3deg_04.0000000001',

 PTRACERS_names( 5)= 'PO4',
 PTRACERS_initialFile( 5)='ptracers_v06_3deg_05.0000000001',

 PTRACERS_names( 6)= 'FeT',
 PTRACERS_initialFile( 6)='ptracers_v06_3deg_06.0000000001',

 PTRACERS_names( 7)= 'SiO2',
 PTRACERS_initialFile( 7)='ptracers_v06_3deg_07.0000000001',

 PTRACERS_names( 8)= 'DOC',
 PTRACERS_initialFile( 8)='ptracers_v06_3deg_08.0000000001',

 PTRACERS_names( 9)= 'DON',
 PTRACERS_initialFile( 9)='ptracers_v06_3deg_09.0000000001',

