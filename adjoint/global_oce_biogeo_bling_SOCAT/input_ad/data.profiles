# **********************
# PROFILES cost function
# **********************
#
# NetCDF-file 'sample_prof.nc' only contains data for variables T, S, PH,
# but if available bling allows many more variables, which are
# left as example namelist entries without effect, because they are
# not in 'sample_prof.nc'.
#
# >> ncdump -h sample_prof.nc
# netcdf sample_prof {
# dimensions:
# 	iPROF = 63 ;
# 	iDEPTH = 25 ;
# variables:
# 	double prof_depth(iDEPTH) ;
# 	double prof_YYYYMMDD(iPROF) ;
# 	double prof_HHMMSS(iPROF) ;
# 	double prof_lon(iPROF) ;
#	double prof_lat(iPROF) ;
# 	double prof_T(iPROF, iDEPTH) ;
#  	double prof_Tweight(iPROF, iDEPTH) ;
# 	double prof_S(iPROF, iDEPTH) ;
# 	double prof_Sweight(iPROF, iDEPTH) ;
# 	double prof_PH(iPROF, iDEPTH) ;
#	double prof_PHweight(iPROF, iDEPTH) ;
# }

 &PROFILES_NML
# profilesDir = 'PROF',
 profilesfiles(1) = 'socat_pco2_clim_month01',
 profilesfiles(2) = 'socat_pco2_clim_month02',
 profilesfiles(3) = 'socat_pco2_clim_month03',
 profilesfiles(4) = 'socat_pco2_clim_month04',
 profilesfiles(5) = 'socat_pco2_clim_month05',
 profilesfiles(6) = 'socat_pco2_clim_month06',
 profilesfiles(7) = 'socat_pco2_clim_month07',
 profilesfiles(8) = 'socat_pco2_clim_month08',
 profilesfiles(9) = 'socat_pco2_clim_month09',
 profilesfiles(10) = 'socat_pco2_clim_month10',
 profilesfiles(11) = 'socat_pco2_clim_month11',
 profilesfiles(12) = 'socat_pco2_clim_month12',
 prof_make_nc = .TRUE.,
 profilesDoNcOutput = .TRUE.,
# Data constraint: SOCATv2026 gridded monthly fCO2, averaged per calendar
# month over 1970-2025 (matching the model's repeating-climatology
# forcing), regridded from 1deg onto the model's 128x64 2.8125deg grid,
# ocean points only. One file per calendar month (Jan-Dec, matching this
# full-year run's Jan 1 2007 start date, 360-day/12x30-day-month model
# calendar), dated mid-month so each falls in the correct simulated
# window. Only the surface pCO2 (PCO, var 13) term is active; T, S, and
# PH are all switched off, for every file.
 mult_profiles(1,1)   = 0.0,
 mult_profiles(1,2)   = 0.0,
 mult_profiles(1,13)  = 1.0,
 mult_profiles(1,14)  = 0.0,
 mult_profiles(2,1)   = 0.0,
 mult_profiles(2,2)   = 0.0,
 mult_profiles(2,13)  = 1.0,
 mult_profiles(2,14)  = 0.0,
 mult_profiles(3,1)   = 0.0,
 mult_profiles(3,2)   = 0.0,
 mult_profiles(3,13)  = 1.0,
 mult_profiles(3,14)  = 0.0,
 mult_profiles(4,1)   = 0.0,
 mult_profiles(4,2)   = 0.0,
 mult_profiles(4,13)  = 1.0,
 mult_profiles(4,14)  = 0.0,
 mult_profiles(5,1)   = 0.0,
 mult_profiles(5,2)   = 0.0,
 mult_profiles(5,13)  = 1.0,
 mult_profiles(5,14)  = 0.0,
 mult_profiles(6,1)   = 0.0,
 mult_profiles(6,2)   = 0.0,
 mult_profiles(6,13)  = 1.0,
 mult_profiles(6,14)  = 0.0,
 mult_profiles(7,1)   = 0.0,
 mult_profiles(7,2)   = 0.0,
 mult_profiles(7,13)  = 1.0,
 mult_profiles(7,14)  = 0.0,
 mult_profiles(8,1)   = 0.0,
 mult_profiles(8,2)   = 0.0,
 mult_profiles(8,13)  = 1.0,
 mult_profiles(8,14)  = 0.0,
 mult_profiles(9,1)   = 0.0,
 mult_profiles(9,2)   = 0.0,
 mult_profiles(9,13)  = 1.0,
 mult_profiles(9,14)  = 0.0,
 mult_profiles(10,1)   = 0.0,
 mult_profiles(10,2)   = 0.0,
 mult_profiles(10,13)  = 1.0,
 mult_profiles(10,14)  = 0.0,
 mult_profiles(11,1)   = 0.0,
 mult_profiles(11,2)   = 0.0,
 mult_profiles(11,13)  = 1.0,
 mult_profiles(11,14)  = 0.0,
 mult_profiles(12,1)   = 0.0,
 mult_profiles(12,2)   = 0.0,
 mult_profiles(12,13)  = 1.0,
 mult_profiles(12,14)  = 0.0,
#
 prof_names(:,1)='prof_T',
 prof_names(:,2)='prof_S',
 prof_names(:,3)='prof_U',
 prof_names(:,4)='prof_V',
 prof_names(:,5)='prof_ptr',
 prof_names(:,6)='prof_ssh',
 prof_names(:,7)='prof_DIC',
 prof_names(:,8)='prof_ALK',
 prof_names(:,9)='prof_O2',
 prof_names(:,10)='prof_NO3',
 prof_names(:,11)='prof_PO4',
 prof_names(:,12)='prof_FE',
 prof_names(:,13)='prof_PCO',
 prof_names(:,14)='prof_PH',
 prof_names(:,15)='prof_CHL',
 prof_names(:,16)='prof_POC',
#
 prof_itracer(:,1)=1,
 prof_itracer(:,2)=1,
 prof_itracer(:,3)=1,
 prof_itracer(:,4)=1,
 prof_itracer(:,5)=1,
 prof_itracer(:,6)=1,
 prof_itracer(:,7)=1,
 prof_itracer(:,8)=2,
 prof_itracer(:,9)=3,
 prof_itracer(:,10)=4,
 prof_itracer(:,11)=5,
 prof_itracer(:,12)=6,
 prof_itracer(:,13)=1,
 prof_itracer(:,14)=1,
 prof_itracer(:,15)=1,
 prof_itracer(:,16)=1,
#
 prof_namesmod(:,1)='theta',
 prof_namesmod(:,2)='salt',
 prof_namesmod(:,3)='uVel',
 prof_namesmod(:,4)='vVel',
 prof_namesmod(:,5)='pTracer',
 prof_namesmod(:,6)='etaN',
 prof_namesmod(:,7)='pTracer',
