# Diagnostic Package Choices
#--------------------
#  dumpAtLast (logical): always write output at the end of simulation (default=F)
#  diag_mnc   (logical): write to NetCDF files (default=useMNC)
#--for each output-stream:
#  fileName(n) : prefix of the output file name (max 80c long) for outp.stream n
#  frequency(n):< 0 : write snap-shot output every |frequency| seconds
#               > 0 : write time-average output every frequency seconds
#  timePhase(n)     : write at time = timePhase + multiple of |frequency|
#    averagingFreq  : frequency (in s) for periodic averaging interval
#    averagingPhase : phase     (in s) for periodic averaging interval
#    repeatCycle    : number of averaging intervals in 1 cycle
#  levels(:,n) : list of levels to write to file (Notes: declared as REAL)
#                when this entry is missing, select all common levels of this list
#  fields(:,n) : list of selected diagnostics fields (8.c) in outp.stream n
#                (see "available_diagnostics.log" file for the full list of diags)
#  missing_value(n) : missing value for real-type fields in output file "n"
#  fileFlags(n)     : specific code (8c string) for output file "n"
#--------------------
 &DIAGNOSTICS_LIST
# blingTracDiag (5-day averaged TRAC01-08) disabled for the FD-sensitivity
# sweep runs -- these are disposable ±eps pairs, only the pCO2 snapshot
# below is actually needed for the cost-function comparison.
# ---
# One-off snapshot of Darwin's own carbonate-chemistry surface pCO2 (NOT
# 'surfpCO2', which is actually the *atmospheric* forcing field per
# darwin_fields_load.F -- 'pCO2' is the ocean-side value computed by
# DARWIN_CALC_PCO2, the correct analog to BLING's PCO/BLGPCO2). Timed to
# land exactly on 2007-01-15 12:00:00 (1,252,800s from the Jan 1 00:00
# start), matching the single mid-month timestamp shared by every SOCAT
# obs in socat_pco2_clim_month01.nc -- pkg/profiles matches each obs to
# whichever instantaneous timestep's interval contains its exact time,
# no averaging/interpolation across time, so one snapshot at this time
# is sufficient (not a running average).
  fileName(2)    = 'darwinPCO2Snap',
  fields(1,2)    = 'pCO2    ',
  levels(1,2)    = 1.,
  frequency(2)   = -1000000000.,
  timePhase(2)   = 1252800.,
 &

#--------------------
# Parameter for Diagnostics of per level statistics:
#--------------------
#  diagSt_mnc (logical): write stat-diags to NetCDF files (default=diag_mnc)
#  diagSt_regMaskFile : file containing the region-mask to read-in
#  nSetRegMskFile   : number of region-mask sets within the region-mask file
#  set_regMask(i)   : region-mask set-index that identifies the region "i"
#  val_regMask(i)   : region "i" identifier value in the region mask
#--for each output-stream:
#  stat_fName(n) : prefix of the output file name (max 80c long) for outp.stream n
#  stat_freq(n):< 0 : write snap-shot output every |stat_freq| seconds
#               > 0 : write time-average output every stat_freq seconds
#  stat_phase(n)    : write at time = stat_phase + multiple of |stat_freq|
#  stat_region(:,n) : list of "regions" (default: 1 region only=global)
#  stat_fields(:,n) : list of selected diagnostics fields (8.c) in outp.stream n
#                (see "available_diagnostics.log" file for the full list of diags)
#--------------------
 &DIAG_STATIS_PARMS
#- an example just to check the agreement with MONITOR output:
#stat_fields(1:5,1)  = 'ETAN    ','UVEL    ','VVEL    ','WVEL    ', 'THETA   ',
# stat_fName(1) = 'dynStDiag',
#  stat_freq(1) = -864000.,
# stat_phase(1) = 0.,
 &

