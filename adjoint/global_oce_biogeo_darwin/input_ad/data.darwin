#######################
# Adapted from a real, previously-tuned darwin3 offline (LLC90) config
# (research/ECCO/offline/from_steph/run_6+4+0_offline/data.darwin) for our
# 128x64 lat-lon grid, matching global_oce_biogeo_bling's circulation/forcing.
# radtrans package is off for this run -- DARWIN_RADTRANS_PARAMS dropped.
#######################
 &DARWIN_FORCING_PARAMS
# iron dust deposition: reusing BLING's own (Mahowald) forcing file, already
# on our grid, as a pragmatic substitute for the reference config's
# Hamilton (2020) product -- not regridding a second iron dataset for this pilot.
 ironFile='mah_flux_smooth.bin',
 ironPeriod= -12.,
 darwin_inscal_iron= 1000.,
#
# wind speed for gas exchange: same file BLING already uses (tren_speed.bin),
# already on our grid.
 windFile='tren_speed.bin',
 windPeriod= -12.,
#
# sea ice fraction: BLING's own forcing file (fice.bin), already on our
# grid. BLING reads this via the core model's generic monthly-climatology
# mechanism (READ_REC_XY_RS, tied to periodicExternalForcing/calendar) --
# Darwin's own loader (exf_set_fld) needs the equivalent "12 calendar
# months" convention (period=-12., same as ironFile/windFile above) to
# read the SAME ice-fraction value at the same time as BLING does. The
# reference config's iceperiod=86400. (daily) was for a different,
# non-climatological ice product and is wrong for this 12-record file --
# it both crashed (ran past record 12) and would have misaligned the
# ice-cover data against BLING's even if it hadn't crashed.
 icefile = 'fice.bin',
 iceperiod     = -12.,
#
# constant atmospheric pCO2 (~2007-era, not the reference config's
# pre-industrial 278ppm) -- revisit if/when comparing directly against BLING's
# own atmospheric CO2 assumption.
 pco2const = 380E-6,
 /
########################
 &DARWIN_PARAMS
 darwin_chlInitBalanced= T,
 diaz_ini_fac= 0.1,
 darwin_seed= 56,
 tempCoeffArr= 1.0,
 PARmin= 0.1,
 alpfe= 1.00,
 freefemax = .1E-3,
 depthfesed= 7000.,
 scav_tau= 1.0,
 scav_inter=9.14351851851E-7,
 scav_psi_wgt=0.0000000000E0,
 scav_pic_wgt=0.0000000000E0,
 scav_poc_wgt=0.06,
 kdoc=  2.314814814814815E-7,   ! 1/50day
 kdop=  2.893500000000000E-7,   ! 1/50day
 kdon=  2.314814814814815E-7,   ! 1/50day
 kdofe= 2.314814814814815E-7,   ! 1/50day
 kPOC=  3.8580246913580247E-7,  ! 1/30day
 kPOP=  4.8225000000000000E-7,  ! 1/30day
 kPON=  3.8580246913580247E-7,  ! 1/30day
 kPOFe= 3.8580246913580247E-7,  ! 1/30day
 kPOSi= 1.5432e-07,             ! 1/75day
 phygrazmin= 120E-10,
 hollexp = 1.E0,
 SURFDICMIN  =   100.0,
 SURFALKMIN  =   100.0,
 /
########################
 &DARWIN_CDOM_PARAMS
  fracCDOM = 0.02,
  cdomdegrd= 3.8580e-08,
  CDOMbleach = 1.9329e-06,
  PARCDOM = 60.,
  CDOMcoeff = 0.1750000,
 /
########################
 &DARWIN_RANDOM_PARAMS
 /
########################
