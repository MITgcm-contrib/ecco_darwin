# *********************
# External Forcing Data -- PointDume L2 (20 m)
# *********************
#
# The forcing files are the L1_East_Pacific ones: same files, same record times and periods as the L1
# run (keep these lines identical to your L1 data.exf). exf_L2/ holds the exf_new files with the LAND
# cells filled by their nearest ocean value (fill_exf_land.py): the originals have land = 0, which
# interpolation would mix into every L2 point near the coast. RUNOFF stays on exf_new (zero over land
# is correct for runoff).
# What changes is that L2 is NOT on the L1 grid, so EXF_NML_04 describes the INPUT (L1) grid
# and EXF interpolates every field onto the L2 grid. Needs
#     #define USE_EXF_INTERPOLATION
# in the L2 code/EXF_OPTIONS.h (it is defined in the L1_East_Pacific one).
#
# L1 input grid (from the L1 grid files): 480 x 360, regular in longitude (1/12 deg),
# NON-uniform in latitude (dlat 0.0719 deg at the south edge to 0.0564 deg at the north edge),
# hence the 359 latitude increments. lon0/lat0 = longitude/latitude of the first (south-west)
# input point, i.e. the centre of L1 cell (1,1); lat_inc(j) is the spacing between rows j and j+1.

 &EXF_NML_01
 useAtmWind        = .TRUE.,
#
 exf_albedo        = 0.1,
 useExfZenIncoming = .TRUE.,
 select_ZenAlbedo  = 1,
#
 ocean_emissivity = 0.97,
 ice_emissivity = 0.95,
 snow_emissivity = 0.95,
#
 exf_iprec         = 32,
 exf_yftype        = 'RL',
 useExfYearlyFields= .TRUE.,
 useExfCheckRange  = .FALSE.,
 /

 &EXF_NML_02
 uwindfile       = 'exf_L2/L1_exf_UWIND',
 vwindfile       = 'exf_L2/L1_exf_VWIND',
 atempfile       = 'exf_L2/L1_exf_ATEMP',
 aqhfile         = 'exf_L2/L1_exf_AQH',
 precipfile      = 'exf_L2/L1_exf_PRECIP',
 swdownfile      = 'exf_L2/L1_exf_SWDOWN',
 lwdownfile      = 'exf_L2/L1_exf_LWDOWN',
#
 atempstartdate1 = 19920101,
 atempstartdate2 = 030000,
 atempperiod = 21600.0,
#
 aqhstartdate1 = 19920101,
 aqhstartdate2 = 030000,
 aqhperiod = 21600.0,
#
 precipstartdate1 = 19920101,
 precipstartdate2 = 030000,
 precipperiod = 21600.0,
#
 runofffile        = 'GloFas_PointDume',
 runoftempfile     = 'GloFas_temp_PointDume',
 runoffstartdate1 = 19920101,
 runoffstartdate2 = 120000,
 runoffperiod = 86400.0,
#
 uwindstartdate1 = 19920101,
 uwindstartdate2 = 030000,
 uwindperiod = 21600.0,
#
 vwindstartdate1 = 19920101,
 vwindstartdate2 = 030000,
 vwindperiod = 21600.0,
#
 swdownstartdate1 = 19920101,
 swdownstartdate2 = 030000,
 swdownperiod = 21600.0,
#
 lwdownstartdate1 = 19920101,
 lwdownstartdate2 = 030000,
 lwdownperiod = 21600.0,
#
 WvHeightfile = 'L2_wave/PointDume_WvHeight',
 WvHeightstartdate1 = 20150101,
 WvHeightstartdate2 = 000000,
 WvHeightperiod = 10800.0,
#
 WvPeriodfile = 'L2_wave/PointDume_WvPeriod',
 WvPeriodstartdate1 = 20150101,
 WvPeriodstartdate2 = 000000,
 WvPeriodperiod = 10800.0,
 /

 &EXF_NML_03
 /

 &EXF_NML_04
