 oasim_waterFile  = 'oasim/bcs/abw25b.dat',
 oasim_slingoFile = 'oasim/bcs/slingo.dat',
#
# oasim_dTsolz is the SUB-STEP used to integrate cos(solar zenith) across one
# model timestep. It is NOT independent of deltaT, and getting it wrong is a
# hard crash, not a bias.
#
# oasim_calc_solz.F:131   nstps = NINT((t2-t1)/dt) + 1   with t2-t1 = deltaT
#                   :193  DO it = 1,nstps,(nstps-1)      <- stride 0 if nstps=1
#                   :237  cosunz = csza(i,j)/(nstps-1)   <- /0    if nstps=1
#
# 900. (the package default, oasim_readparms.F:93) against deltaT=300 gives
# NINT(300/900)+1 = NINT(0.333)+1 = 1, so BOTH of those fire. dt-test attempt 8
# (25223589) died with SIGFPE on every rank, identical stack:
#   oasim_calc_solz_ <- oasim_forcing_ <- oasim_fields_load_
#     <- load_fields_driver_ <- forward_step_
# It had already cleared initialisation and printed the iteration-0 monitor, so
# this is the first thing to kill the model DURING stepping rather than before.
#
# The requirement is nstps >= 2, i.e. deltaT >= oasim_dTsolz/2.
#
#   dTsolz |  DT=100 150 200 300 450 600 900   (nstps; 1 = CRASH)
#   -------+-------------------------------------------------
#      900 |     1   1   1   1   2   2   2
#      450 |     1   1   1   2   2   2   3
#      300 |     1   2   2   2   3   3   4
#      150 |     2   2   2   3   4   5   7     <- chosen
#
# 150. is safe for every deltaT the dt test can sweep (job_dt_test.sh requires
# DT to divide 86400, so DT >= 100), and it leaves headroom if the CFL result
# pushes deltaT down. It also gives a 3-point integration at deltaT=300 rather
# than the bare 2-point trapezoid that 300. would give.
#
# DO NOT "fix" a future recurrence by raising deltaT to suit this parameter --
# deltaT is set by CFL, this follows it.
# Nares 2026-10-30: deltaT 60 s -> 150 gives nstps = NINT(60/150)+1 = 1 -> loop step 0 -> SIGFPE (run_bgc_test2d crash).
# 60 gives nstps = 2 (2-point integration, as west_AO 180/150). pan_AO/west_AO keep 150 (their deltaT 300/180).
 oasim_dTsolz = 60.,
# oasim_monitorfreq = 3600.,
 &
 &OASIM_3STREAM_PARM
 &
