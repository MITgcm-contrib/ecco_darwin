# constituents M2,S2,N2,K2,K1,O1,P1,Q1; phase zero = startDate 2015-01-01; nodal f,u at 2015-01-16; gen_obcs_tides.py
# amplitudes scaled per constituent to the FES2022 prism budget (M2 .917 S2 1.02 N2 .99 K2 .943 K1 .909 O1 .99 P1 .893 Q1 1)
