# Nares 1-km regional run (2026-10-07). Adapted from pan_AO input/data.exf.
# Comments below that are not marked 'Nares' are inherited from pan_AO
# (dates, job ids and file names in them refer to pan_AO).
#
# Nares: same ERA5 hourly yearly files as pan_AO (ERA5 -> hzhang1/forcing/era5,
# 1991-2026) and the same hourly OBCS convention (record 1 at 00:00); all
# active start dates move to 2015-01-01 (parent extraction nIter0 = 604872 =
# 2015-01-01 00:00). No EXF runoff yet: Humboldt discharge goes through
# iceplume (never also via EXF runoff).
#
# *********************
# External Forcing Data
# *********************
# ERA5 atmospheric forcing (EXF_NML_01/02[atmos fields only]/03/04) reused
# as-is from GoM_1km, per DECISIONS.md's locked decision ("Atmospheric
# forcing: ERA5, region-independent, reused as-is -- same as kerguelen").
# River runoff (locked "yes" decision, Arctic rivers Ob/Yenisei/Lena/
# Mackenzie etc.) and the EXF_NML_OBCS boundary-forcing block are
# deliberately NOT wired up here -- see TODOs below.
#
 &EXF_NML_01
 exf_albedo        = 0.1,
 useExfZenIncoming = .TRUE.,
 select_ZenAlbedo  = 1,
#
 ocean_emissivity  = 0.97,
 ice_emissivity    = 0.95,
 snow_emissivity   = 0.95,
 exf_iprec         = 32,
 exf_yftype        = 'RL',
 useExfYearlyFields= .TRUE.,
 useExfCheckRange  = .FALSE.,
 useRelativeWind   = .TRUE.,
 &
#
 &EXF_NML_02
 apressurefile     = 'ERA5/ERA5_pres',
 atempfile         = 'ERA5/ERA5_tmp2m_degC',
 aqhfile           = 'ERA5/ERA5_spfh2m',
 precipfile        = 'ERA5/ERA5_rain',
 uwindfile         = 'ERA5/ERA5_u10m',
 vwindfile         = 'ERA5/ERA5_v10m',
 swdownfile        = 'ERA5/ERA5_dsw',
 lwdownfile        = 'ERA5/ERA5_dlw',
#
# ALL startdate1 below: 19920101 -> 20200101 (2026-10-02).
#
# 19920101 is the parent LLC270 v5r1 calendar BASE, which is what the
# scaffold defaulted every EXF field to. It is NOT this run's start date:
# the ICs are pinned to parent iteration 736344 = 1992-01-01 + 883,612,800 s
# = exactly 2020-01-01, and data.cal startDate_1 is now 20200101 to match.
#
# useExfYearlyFields=.TRUE. does NOT make 19920101 harmless here -- kerguelen
# runs the SAME parent pickups at the SAME iteration with 20200101 on every
# one of these fields. The EXF_NML_OBCS block below was already set to
# 20200101 when real OBCS files landed on 10-01; it was the disagreement
# between that block and this one that exposed the rest.
#
# This is the quiet kind of error: every ERA5 yearly file exists and is the
# right size, so a 28-year-offset run starts clean, never warns, and simply
# forces the Arctic with weather from the wrong end of the archive.
#
 apressurestartdate1 = 20150101,
 apressurestartdate2 = 000000,
 apressureperiod   = 3600.0,
#
 atempstartdate1   = 20150101,
 atempstartdate2   = 000000,
 atempperiod       = 3600.0,
#
 aqhstartdate1     = 20150101,
 aqhstartdate2     = 000000,
 aqhperiod         = 3600.0,
#
 precipstartdate1  = 20150101,
 precipstartdate2  = 003000,
 precipperiod      = 3600.0,
#
# TODO (river runoff, locked "yes" decision, NOT wired up here -- adapting
# this jra55_do_runoff mechanism to the real Arctic rivers (Ob, Yenisei,
# Lena, Mackenzie, etc.) is explicitly deferred pending user input, per
# task scope. Left commented, not fabricated. Its startdate1 is carried to
# 20200101 with the rest ON PURPOSE: if this block is ever uncommented, a
# stale 19920101 sitting here would silently reintroduce the exact 28-year
# offset being fixed above.
# runofffile        = 'jra55_do_runoff_panAO',
# runoffstartdate1  = 20200101,
# runoffstartdate2  = 120000,
# runoffperiod      = 86400.0,
#
 uwindstartdate1   = 20150101,
 uwindstartdate2   = 000000,
 uwindperiod       = 3600.0,
#
 vwindstartdate1   = 20150101,
 vwindstartdate2   = 000000,
 vwindperiod       = 3600.0,
#
 swdownstartdate1  = 20150101,
 swdownstartdate2  = 003000,
 swdownperiod      = 3600.0,
#
 lwdownstartdate1  = 20150101,
 lwdownstartdate2  = 003000,
 lwdownperiod      = 3600.0,
#
 &
#
 &EXF_NML_03
 exf_offset_atemp   = 273.15,
 exf_inscal_swdown  = -1.0,
 exf_inscal_lwdown  = -1.0,
 exf_inscal_precip  = 1.0,
# exf_inscal_runoff  = 1.0,   (runoff deferred for pan_AO 2026-09-28)
 &
