#!/bin/bash
# job_build_ncgrid -- build mitgcmuv for the Nares gen_ncgrid config (exch2 single facet) (STEP1.IV).
# Copied from fiji/gen_ncgrid/job_build_ncgrid (full build-dir wipe, -rootdir,
# vendor-dispatch flags stripped so the binary runs on AMD rom_ait).
# Shared darwin3 tree, as fiji: grid geometry does not depend on the darwin3
# checkpoint. (Revisit if the regional_run ends up on pan_AO's darwin3_ckpt69k
# and its grid code differs.)
#PBS -l select=1:ncpus=16:model=sky_ele
#PBS -q normal
#PBS -l walltime=1:00:00
#PBS -N naresncgrid_build
#PBS -W group_list=g26113
#PBS -j oe
#PBS -o /nobackup/dcarrol2/downscaling/nares/gen_ncgrid/job_build_out.txt
set -e
module purge
module load comp-intel/2023.2.1 mpi-hpe/mpt.2.30 hdf4/4.2.12 hdf5/1.8.18_mpt netcdf/4.4.1.1_mpt python3/3.9.12
umask 022
DARWIN3=/nobackup/dcarrol2/v05_V5r1/darwin3
GN=/nobackup/dcarrol2/downscaling/nares/gen_ncgrid
rm -rf "$GN/build"; mkdir -p "$GN/build"; cd "$GN/build"
"$DARWIN3/tools/genmake2" -rootdir "$DARWIN3" \
  -of "$DARWIN3/tools/build_options/linux_amd64_ifort+mpi_ice_nas" \
  -mpi -mo "$GN/code"
sed -i 's/ -axCORE-AVX2 -xSSE4\.2//' Makefile
grep -n "^FOPTIM\|^F90OPTIM" Makefile
make depend
make -j 16
echo "BUILD_DONE"; ls -la mitgcmuv
