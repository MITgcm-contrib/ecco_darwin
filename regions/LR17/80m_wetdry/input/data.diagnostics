# v4 obs run (43 d): diagnostics of run_v3_obs43 (hourly sea level, 6-h surface snapshots, daily-mean 3-D T/S) + hourly level-1 U, V (uv1, AWAC)
 &DIAGNOSTICS_LIST
 fields(1:3,1)='ETAN    ','WDdepth ','WDdryC  ',
 fileName(1)='sfc', frequency(1)=-21600.0, timePhase(1)=0.,
 fields(1:4,2)='UVEL    ','VVEL    ','SALT    ','THETA   ',
 levels(1,2)=1., fileName(2)='top', frequency(2)=-21600.0, timePhase(2)=0.,
 fields(1:2,3)='THETA   ','SALT    ',
 fileName(3)='TS3d', frequency(3)=86400., timePhase(3)=0.,
 fields(1,4)='ETAN    ',
 fileName(4)='eta', frequency(4)=-3600.0, timePhase(4)=0.,
 fields(1:2,5)='UVEL    ','VVEL    ',
 levels(1,5)=1., fileName(5)='uv1', frequency(5)=-3600.0, timePhase(5)=0.,
 &
 &DIAG_STATIS_PARMS
 diagSt_regMaskFile='gauge_mask.bin',
 nSetRegMskFile=1,
 set_regMask(1:2)=1,1,
 val_regMask(1)=1., val_regMask(2)=2.,
 stat_fields(1,1)='ETAN    ',
 stat_fName(1)='gauges', stat_freq(1)=600., stat_phase(1)=0.,
 stat_region(1:2,1)=1,2,
 &
