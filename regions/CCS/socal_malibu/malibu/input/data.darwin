 pCO2_lat_inc = 0.6958694,0.6999817,0.7009048,0.7012634,0.7014313,
                245*0.7017418,
                0.7014313,0.7012634,0.7009048,0.6999817,0.6958694
 pCO2_nlon    = 2,
 pCO2_nlat    = 256,
 /
 &DARWIN_PARAMS
# do not read darwin pickup
 darwin_pickupSuff= ' ',
 darwin_chlInitBalanced= .FALSE.,
 darwin_chlIter0= 1,
 darwin_seed= 56,
 ALPFE   =  0.92831,
 FREEFEMAX       =  1E-4,
 SCAV_RAT        =   6.02502315E-7,
 DEPTHFESED      =   7000.0,
# KDOC    =  1.157407407407407E-7,
 KDOP    =  2.314814814814815E-7,
 KDON    =  2.314814814814815E-7,
 KDOFE   =  2.314814814814815E-7,
# KPOC    =  2.314814814814815E-7,
 KPOP    =  4.629629629629630E-7,
 KPON    =  4.629629629629630E-7,
 KPOFE   =  4.629629629629630E-7,
 KPOSI   =  7.716049382716049E-8,
 SURFDICMIN  =   100.0,
 SURFALKMIN  =   100.0,
 /
# CDOM tracer (DARWIN_ALLOW_CDOM), darwin3 24885b71 code defaults: fracCDOM = 0.02,
# CDOMdegrd = 1/200 d, CDOMbleach = 1/15 d, PARCDOM = 20, R_NP/R_CP/R_FeP_CDOM
# = 16/120/1e-3, CDOMcoeff = 100 m-1/(mmol P m-3) (a at 450 nm)
 &DARWIN_CDOM_PARAMS
# [CD1] 2026-10-18, adopted as default 2026-10-20: fracCDOM 0.02 -> 0.008 (spring CDOM 2-4x above PACE adg; April budget:
# ~80% of CDOM from the dissolved share of mortality + exudation; loss timescale ~30 d ~ PACE Apr->May decline)
 fracCDOM = 0.008,
 /
 &DARWIN_MACROALGAE_PARAMS
 mp_spp_Vmax_NO3 = 2.09E-4
 mp_spp_Ks_NO3 = 10.20
 mp_spp_Vmax_NH4 = 2.05E-4
 mp_spp_Ks_NH4 = 5.31
 mp_spp_Vmax_Urea = 3.33E-6
 mp_spp_Ks_Urea = 7.75
# v3 (2026-10-13): Gmax_cap 2.31E-6 -> 2.0E-6 (0.20 -> 0.173 /d). S5 biomass-weighted gross growth
# (kelp_growth_diag.py) was 0.060/0.051/0.046 /d Mar/Apr/May vs SBC LTER knb-lter-sbc.112.15 spring
# 0.039 /d; scaling S5 gross by 0.87 with S5 loss gives ln(2.82) net growth mid-Feb to mid-May,
# the KelpWatch Malibu 2025 Q1->Q2 increase (106 -> 299 t)
# v4w_smg155 (2026-11-01): Gmax_cap 0.173 -> 0.155 /d with seasonal mortality (sm May 16 362 t vs KelpWatch 299)
 mp_spp_Gmax_cap = 1.7939815E-6
# malibu_v01: G-MACMODS Macrocystis (umol photons m-2 s-1)
 mp_spp_PARs = 212.4
 mp_spp_PARc = 20.45
 mp_spp_Qmin = 10.18
 mp_spp_Qmax = 54.0
 mp_spp_Topt1 = 13.0
 mp_spp_K1 = 0.04
 mp_spp_Topt2 = 18.0
 mp_spp_K2 = 0.05
 mp_spp_CD = 0.5
 mp_spp_E = 2.31E-8
# kelp background mortality 0.015 /d: SBC LTER Macrocystis winter (Dec-Feb) frond loss 0.0151 /d
# (Rassweiler et al. 2008, Ecology 89:2068, Ecol. Archives E089-119 loss-rate data); within
# the G-MACMODS Monte Carlo range 0.003-0.017 /d (magpy/mag_montecarlo.py)
# S5 (2026-10-12): 0.03 /d, SBC LTER knb-lter-sbc.112.15 total loss (plant + frond + cut + blade,
# Jan-Jun mean ~0.039 /d, DOM excluded) minus the model mean wave loss (~0.007 /d, run_2025h1);
# above the G-MACMODS Monte Carlo range 0.003-0.017 /d
 mp_spp_death = 3.4722E-07
# v4w_sm (2026-10-31): seasonal background mortality [SM1] (code_seasmort, build_seasmort): SBC LTER
# knb-lter-sbc.112.15 monthly median loss (plant+frond+cut+blade, 3 sites 2002-2026) minus 0.0035 d-1 wave loss,
# 1/s, Jan..Dec, linear between mid-month values (overrides mp_spp_death)
 mp_spp_death_mon = 4.8852E-07, 3.4526E-07, 4.2790E-07, 3.2950E-07, 2.2111E-07, 2.4087E-07,
                    2.3256E-07, 1.9566E-07, 2.3311E-07, 2.5351E-07, 3.2639E-07, 2.5834E-07,
 mp_wave_mort_factor = 1.0
 mp_spp_katten = 1.0E-4
 mp_spp_carbon = 0.3
 mp_spp_vertical = .TRUE.
 mp_spp_length_subsurface = 109.98
 mp_spp_length_canopy = 243.46
 mp_spp_length_watercolumn = 98.7
 mp_spp_maxlength = 30.0
 mp_spp_allN = .TRUE.
/
 &DARWIN_TSS_PARAMS
# settling, deposition and resuspension of TSS are done by pkg/sediment
 wTSS_sink = 0.,
 katten_TSS = 0.07,
/
 &DARWIN_RADTRANS_PARAMS
 darwin_waterAbsorbFile='OPTICS_COEFF2/optics_water.txt',
 darwin_phytoAbsorbFile='OPTICS_COEFF2/optics_plankton.txt',
 darwin_particleAbsorbFile='OPTICS_COEFF2/optics_detritus.txt',
 darwin_part_size_P = 1e-15,
 /
 &DARWIN_RANDOM_PARAMS
 smallgrow=0.66098,
 biggrow=0.43148,
 diatomgraz=0.83003,
 val_R_PICPOC=0.04245,
 /
 &DARWIN_TRAIT_PARAMS
