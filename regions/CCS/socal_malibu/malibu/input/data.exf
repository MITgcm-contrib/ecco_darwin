# *********************
# External Forcing Data
# *********************
#
 &EXF_NML_01
  useAtmWind        = .TRUE.,
# TO COMBINE WITH ALLOW_ZENITH_ANGLE:
  exf_albedo        = 0.1,
  useExfZenIncoming = .TRUE., 
  select_ZenAlbedo  = 1,
#
  ocean_emissivity  = 0.97,
  ice_emissivity    = 0.95,
  snow_emissivity   = 0.95,
#
  exf_iprec         = 32,
  exf_yftype        = 'RL',
  useExfYearlyFields= .TRUE.,
  useExfCheckRange  = .FALSE.,
 /

 &EXF_NML_02
# atmosphere: sea-filled ERA5 hourly box of the socal 2-km nest (era5_seafill_box.py)
# hourly waves (python/make_waves.py --source waverys, 2026-10-26: Copernicus WAVERYS 0.2 deg) for kelp wave mortality
  WvHeightfile = 'waves/waverys_WvHeight',
  WvHeightstartdate1 = 19920101,
  WvHeightstartdate2 = 000000,
  WvHeightperiod = 3600.0,
  WvPeriodfile = 'waves/waverys_WvPeriod',
  WvPeriodstartdate1 = 19920101,
  WvPeriodstartdate2 = 000000,
  WvPeriodperiod = 3600.0,
  atempfile = 'era5_seafill/ERA5_tmp2m_degC',
  aqhfile = 'era5_seafill/ERA5_spfh2m',
  precipfile = 'era5_seafill/ERA5_rain',
  uwindfile = 'era5_seafill/ERA5_u10m',
  vwindfile = 'era5_seafill/ERA5_v10m',
  swdownfile = 'era5_seafill/ERA5_dsw',
  lwdownfile = 'era5_seafill/ERA5_dlw',
#
  atempstartdate1   = 19920101,
  atempstartdate2   = 000000,
  atempperiod = 3600.0,
#
  aqhstartdate1     = 19920101,
  aqhstartdate2     = 000000,
  aqhperiod = 3600.0,
#
  precipstartdate1  = 19920101,
  precipstartdate2 = 003000,
  precipperiod = 3600.0,
#
# Malibu Creek point source on the nest grid (python/make_rivers.py)
  runofffile        = 'rivers/rivers_runoff_128x72',
  runoffstartdate1  = 19920101,
  runoffstartdate2  = 120000,
  runoffperiod      = 86400.0,
#
  uwindstartdate1   = 19920101,
  uwindstartdate2   = 000000,
  uwindperiod = 3600.0,
#
  vwindstartdate1   = 19920101,
  vwindstartdate2   = 000000,
  vwindperiod = 3600.0,
#
  swdownstartdate1  = 19920101,
  swdownstartdate2 = 003000,
  swdownperiod = 3600.0,
#
  lwdownstartdate1  = 19920101,
  lwdownstartdate2 = 003000,
  lwdownperiod = 3600.0,
#
#
 /

 &EXF_NML_03
# ERA5 (hzhang1 forcing/era5) conventions, as in socal regional_run data.exf
  exf_offset_atemp  = 273.15,
  exf_inscal_swdown = -1.0,
  exf_inscal_lwdown = -1.0,
  exf_inscal_precip = 1.0,
 /

