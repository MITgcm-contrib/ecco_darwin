 &EXF_NML_OBCS
# 2026-09-14: period was 2629800.0 (~monthly), a GoM_1km template leftover
# that didn't match the hourly (3600s) OBCS files gen_obcs_fast.py actually
# produces. Since useOBCSprescribe=.TRUE. + useEXF=.TRUE., pkg/obcs's
# OBCS_PRESCRIBE_READ calls OBCS_EXF_LOAD, which indexes {VAR}_{bnd}.bin
# using THIS period via EXF_GetFFieldRec -- so the wrong period meant the
# model only ever advanced through the first ~36 of each file's 26304
# hourly records over the full 3-year run (record index computed from
# elapsed_time/period, not from the file's real record count). Confirmed
# via direct read of THETA_north.bin: record 19 (what the bug read at sim
# day ~571) = 9.23degC, record 13728 (what should have been read at that
# point) = 8.24degC. Fixed to match the real hourly file cadence. See
# DECISIONS.md 2026-09-14 entry.
  obcsNstartdate1   = 20191231,
  obcsNstartdate2   = 002000,
  obcsNperiod       = 3600.0,
#
  obcsSstartdate1   = 20191231,
  obcsSstartdate2   = 002000,
  obcsSperiod       = 3600.0,
#
  obcsEstartdate1   = 20191231,
  obcsEstartdate2   = 002000,
  obcsEperiod       = 3600.0,
#
# Kerguelen has a 4th (west) open boundary, unlike GoM_1km
  obcsWstartdate1   = 20191231,
  obcsWstartdate2   = 002000,
  obcsWperiod       = 3600.0,
/
