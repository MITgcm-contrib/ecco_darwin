#
# ******************************
# Model parameters
# Continuous equation parameters
# ******************************
#
# NOTE on what changed vs. Steph's original 1-deg set-up (data) and why:
#
# - tRef/sRef/delR (PARM01/PARM04): MUST become 50 values (Nr=50, LLC90).
#   Taken verbatim from ECCOv4 Release 6's own "namelist/data" (fetched
#  ), the real reference profile for this grid -- not
#   invented.
# - eosType='JMD95Z' (was 'POLY3'): adopted from ECCOv4r6 (POLY3 was
#   specific to Steph's ECCO-Iteration-3.73 product line).
# - exactConserv=.TRUE.: added -- pairs with CPP_OPTIONS.h's (already
#   present) #define EXACT_CONSERV; harmless, recommended pairing.
# - usingCurvilinearGrid replaces usingSphericalPolarGrid/delX/delY
#   (PARM04): required for LLC90. No horizGridFile is set -- MITgcm
#   defaults to reading tile001..005.mitgrid from the run directory,
#   which is where the verified grid files from
#   bathy/grid/ECCO_V4r5/ must be placed/symlinked.
#
# What did NOT change, deliberately, and why (see CPP_OPTIONS.h's file
# header for the fuller version of this argument): momentum, T and S
# are completely overwritten from file every timestep by pkg/offline
# (see offline_fields_load.F), so viscosity/diffusivity coefficients,
# advection-scheme numbers, and the free-surface formulation
# (nonlinFreeSurf, select_rStar, staggerTimeStep,
# vectorInvariantMomentum, ...) are inert for this run's actual
# purpose (driving Darwin's 36 ptracers) and are kept at Steph's
# proven values rather than imported from ECCOv4r6's own (physically
# real, but here irrelevant) forward-run tuning. Only
# PTRACERS_advScheme (in data.ptracers) governs how the ptracers
# themselves step forward, and that carries over unchanged from
# Steph's setup.
#
&PARM01
tRef= 3*23.,3*22.,21.,2*20.,19.,2*18.,17.,2*16.,15.,14.,13.,
      12.,11.,2*9.,8.,7.,2*6.,2*5.,3*4.,3*3.,4*2.,12*1.,
sRef= 50*34.5,
no_slip_sides=.false.,
no_slip_bottom=.TRUE.,
# FIXED: viscAz/diffKzT/diffKzS (Steph's original z-coordinate
# names, unchanged from her 1-degree config) conflict with PARM04's delR
# (r-coordinate, required for this port's usingCurvilinearGrid LLC90
# grid) -- ini_parms.F flags any z-suffixed AND r-suffixed parameter set
# together as "Cannot mix z, p and r in the input data" (a fatal error,
# not silent), caught on the first-ever test run of this build. Renamed
# to their r-coordinate equivalents; same values, since this grid's r
# coordinate already is real depth (delR is in meters, same as delZ
# would have been) -- purely a naming-convention fix, not a physics one.
viscAr=1.E-3,
viscAh=1.E4,
diffKhT=1.E2,
diffKrT=1.E-5,
diffKhS=1.E2,
diffKrS=1.E-5,
beta=1.E-11,
tAlpha=2.E-4,
sBeta =7.4E-4,
gravity=9.81,
gBaro=9.81,
rigidLid=.FALSE.,
implicitFreeSurface=.true.,
exactConserv=.TRUE.,
eosType='JMD95Z',
saltStepping=.TRUE.,
tempStepping=.TRUE.,
momStepping=.TRUE.,
implicitDiffusion=.true.,
implicitViscosity=.true.,
allowFreezing=.false.,
# CHANGED: was .TRUE. (Steph's original, and this port's default
# through the first two test runs). Confirmed against pkg/mdsio/
# mdsio_read_field.F + eesupp/src/master_cpu_io.F: MASTER_CPU_IO gates
# MDS_READ_FIELD's actual disk I/O on ".NOT.useSingleCpuIO .OR. myProcId
# .EQ.0" -- with it .TRUE., every MDS_READ_FIELD call (the daily physics
# archive fields DDtheta/DDuvel/DDvvel/DDwvel/DDsalt/DGMkw/DGGL90/DFOSflux,
# plus BGC runoff -- none of these have a lon/lat interpolation block, so
# none go through EXF_INTERP_READ's separate useSingleCpuInput toggle) is
# done by rank 0 alone while the other 112 ranks block on the broadcast.
# Strong candidate for the ~35% CPU utilization measured on the 1-year test
# (73:06:50 CPU / 01:51:02 wall / 113 ranks). Turning this off parallelizes
# those reads at the cost of pickup/diagnostic writes becoming one file per
# tile instead of one combined global file -- acceptable, since
# MITgcmutils.rdmds (already used by util/regrid/plot_ic_*.py) and xmitgcm both
# read per-tile MDS output transparently.
useSingleCpuIO=.FALSE.,
useCDscheme=.FALSE.,
tempAdvScheme = 3,
saltAdvScheme = 3,
readBinaryPrec= 32,
writeBinaryPrec= 32,
debugLevel=1,
/

# **************************
# Elliptic solver parameters
# **************************
&PARM02
cg2dMaxIters=300,
cg2dTargetResidual=1.E-7,
/

# ************************
# Time stepping parameters
# ************************
&PARM03
# FIXED: was nIter0=1 (wrongly copied from input_v4r6_forward/data's
# convention, which legitimately starts from a real physical pickup at
# iteration 1). This offline Darwin run has no physical pickup at all -- it
# must cold-start at nIter0=0, matching PTRACERS_Iter0=0 in data.ptracers
# and Steph's own original run_6+4+0_offline/data (also nIter0=0). With the
# mismatched nIter0=1, ptracers_init_varia.F's
# "IF (nIter0.EQ.PTRACERS_Iter0)" gate would have been FALSE, silently
# skipping every PTRACERS_initialFile read entirely and instead trying to
# read a pickup_ptracers.0000000001.* that doesn't exist -- every regridded
# IC in data.ptracers would have been ignored by the actual run.
 nIter0= 0,
#nTimeSteps=298031 is ECCOv4r6's full 12Z 1992/1/1 - 12Z 2025/12/31
# record; set nIter0/nTimeSteps per actual run segment, chunked by
# pChkptFreq/chkptFreq below (restart via pickup, same pattern as
# Steph's data/data_org nIter0 pair -- data_org's nIter0=25920 is a LATER
# restart segment, not the first one; this file is the first segment and
# must start at 0).
 nenditer=298031,
 deltaTmom=3600.,
 deltaTtracer=3600.,
 deltaTClock =3600.,
#-- REVERTED: this briefly used AB3 coefficients (alph_AB/
#   beta_AB), paired with CPP_OPTIONS.h's ALLOW_ADAMSBASHFORTH_3 --
#   reverted together with that flag (see its header comment) because
#   it left ALLOW_ADAMSBASHFORTH_3 combined with GAD_SMOLARKIEWICZ_HACK,
#   a documented-incompatible combination for ptracer advection. Back
#   to Steph's own validated AB2 coefficient (matching her original
#   run_6+4+0_offline/data):
 forcing_In_AB=.FALSE.,
 momDissip_In_AB=.FALSE.,
 doAB_onGtGs=.FALSE.,
 abEps=0.1,
 pChkptFreq  = 31536000.,
 chkptFreq   = 31536000.,
 dumpFreq    = 31536000.,
 dumpInitAndLast=.FALSE.,
 taveFreq    = 31536000.,
 monitorFreq = 31536000.,
 tauThetaClimRelax=0.,
 tauSaltClimRelax=0.,
/

