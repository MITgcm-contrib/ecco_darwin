#
 a_PCmax_denom(:)= 6*86400.,
 b_PCmax(:)=  0.28, 0.28, -0.10, -0.10, -0.10,-0.10, 0.,
#
 a_Qpmin = 6*0.005, 0.008,
 a_Qpmax = 6*0.02,  0.01,
#
 darwin_effective_ksat= T,
 darwin_select_kn_allom= 2,
#
 grp_ExportFracPreyPred(1:6,7)= 6*.8,
 a_R_ChlC(7)= 0.,
 a_grazemax(7)= 3.4722000000000000E-05,  ! prowe values
 b_grazemax(7)= -0.16,
#
 a_phytoTempExp2= 7*.0003,
 a_R_PC(:)= 7*0.008333333333333333,
 a_R_FeC(:)= 3*0.008333333333333333E-3, 1*0.03333333333333333E-3, 3*0.008333333333333333E-3,
 a_R_NC(:)= 7*0.13333333333333333,
 a_R_SiC(:)= 4*0., 0.39999999999999999, 2*0.,
 a_kgrazesat(:)= 7*10.0,
 b_kgrazesat(:)= 7*0,
#
  grp_ass_eff(:,:)=49*0.32,
/
