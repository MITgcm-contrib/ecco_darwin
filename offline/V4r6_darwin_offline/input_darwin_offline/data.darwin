#######################
 &DARWIN_FORCING_PARAMS
# wind regridded by run_regrid_steph_ics.py -- bare filename,
# symlinked from regridded_llc90/ per readme.txt Part 7.
# Source (pre-regrid) path, for traceability: steph_input/forcing/tren_speed_mth-2d.bin
#
# iron SWITCHED from Steph's own
# hamilton20_monthmeanSFe.bin to ecco_darwin's copy of the same underlying
# Hamilton et al. 2020 iron deposition product, on ITS native 144x96
# monthly grid -- copied verbatim (filename, period, scale factor, and the
# iron_lon0/lat0/nlon/nlat/lat_inc runtime-interpolation block) from
# v06/1deg/input_darwin_v4r5_v2/data.darwin. Unlike Steph's copy, this
# does NOT need Python pre-regridding: because ecco_darwin's config
# supplies the iron_lon0/etc. parameters, pkg/darwin's generic loader
# (darwin_exf_load.F) interpolates from the file's own 144x96 grid onto
# this run's xC/yC at runtime -- same mechanism as pCO2File below. Steph's
# darwin_inscal_iron=1000 does NOT carry over: it was calibrated for her
# specific file's native units/values, and ecco_darwin's own scale factor
# (17906.70606142) is calibrated for THIS file instead -- mixing the two
# would silently produce a wrong absolute forcing magnitude. Confirmed
# location:
# /nobackup/ojahn/ecco_darwin/v06/llc270/data_darwin/CESM-MIMI_1980-2015_CAM4-6MEAN_MonthlyDep_Hamiltonetal2020_clim.R4_144x96x12.bin
# -- note this real filename differs slightly from the one named in
# v06/1deg/input_darwin_v4r5_v2/data.darwin (no "_kgFem2s_", "_clim.R4"
# not "_clim1980-2015.R4"); using the confirmed real name below, not the
# 1deg config's. It lives under a "llc270" directory but that's just
# which run it's staged alongside -- the file itself is still the raw
# 144x96 native grid (interpolated at runtime via iron_lon0/etc. below,
# grid-agnostic on the output side), so it's the right file for our
# LLC90 run too, not llc270-specific data.
#
# BUG FOUND AND FIXED, once the real file arrived and could be
# checked byte-for-byte: iron_nlat was 95 (copied verbatim from
# v06/1deg/input_darwin_v4r5_v2/data.darwin), but the real file is
# 144*96*12*4 = 663552 bytes -- 96 latitude points, not 95 (144*95*12*4 =
# 656640 does not match). Confirms iron_lat0=-90 + 95*iron_lat_inc =
# -90 + 95*1.894736842105263 = +90.0 exactly, i.e. 95 increments span the
# full pole-to-pole range across 96 POINTS -- iron_lat_inc's array length
# (95 values) was already correct for 96 points; only the nlat point-count
# parameter itself was off by one. Left uncorrected, this would have
# misaligned every latitude row in pkg/darwin's runtime interpolation (or
# caused a size mismatch) -- ecco_darwin's own 1-degree config apparently
# never triggered this before it was noticed here.
 ironFile='CESM-MIMI_1980-2015_CAM4-6MEAN_MonthlyDep_Hamiltonetal2020_clim.R4_144x96x12.bin',
 ironPeriod= -12.,
 darwin_inscal_iron= 17906.70606142,
#
 windFile='tren_speed_mth-2d_llc90.bin',
 windPeriod= -12.,
#
 icefile = 'DSIarea/DSIarea',
 icestartdate1 = 19920101,
 icestartdate2 = 120000,
 iceperiod     = 86400.0,
#
# Replaced: Steph's original used a hardcoded pco2const=278E-6
# (pre-industrial reference) -- fine for her idealized 360-day-climatology
# setup, but wrong for a real 1992-2025 run where atmospheric CO2 actually
# rose from ~356 to ~420+ ppm over the record. Switched to the real
# historical/observed record instead, following ecco_darwin's own
# v06/1deg/input_darwin_v4r5_v2/data.darwin convention exactly (same
# pCO2startdate1=19920101 -- already matches our own calendar start).
# pCO2File is NOAA's Marine Boundary Layer product: unlike
# PTRACERS_initialFile/ironFile/windFile, this does NOT need Python
# pre-regridding -- pkg/darwin's own generic loader (darwin_exf_load.F)
# interpolates at runtime from the file's native grid onto this run's own
# xC/yC, given the parameters in the DARWIN_INTERP_PARAMS block below.
# Data itself lives on Pleiades at /nobackup/dcarrol2/forcing/apCO2/NOAA_MBL/
# (see readme.txt Part 7) -- nothing to regrid or transfer to the
# Mac for this one.
#
# FIXED: pCO2File='apCO2' (bare name) crashed the first-ever run
# attempt -- EXF_INTERP_READ: "filename: apCO2 / File does not exist". The
# real data at NOAA_MBL/ is 49 separate per-calendar-year files
# (apCO2_1979 .. apCO2_2027, confirmed: file sizes match exactly 365/366
# daily records on a 256x2 grid per real calendar year), but pCO2File is
# read via the SAME EXF_INTERP_READ direct-access single-file mechanism
# as RT_icefile/DSIarea above -- it has no per-field "yearly fields"
# support of its own; darwin_exf_init_fixed.F passes the GLOBAL
# useExfYearlyFields flag for pCO2 (shared with windFile's own call),
# which we deliberately leave unset in data.exf specifically to avoid
# affecting windFile (a single perpetual climatology file, not
# per-year) -- so turning that flag on was not a safe fix. Concatenated
# all 49 yearly files into one combined file instead (same pattern as
# DSIarea above, via `cat` in chronological order -- see
# readme.txt Part 7), and updated pCO2startdate1 to the combined
# file's REAL first record (1979-01-01, not 1992 -- this file's record 0
# is genuinely 1979, unlike our own archive which starts at 1992):
 pCO2File = 'apCO2_combined',
 pCO2startdate1 = 19790101,
 pCO2startdate2 = 120000,
 pCO2period     = 86400.0,
#
# BGC river runoff/discharge, added, copied
# from ecco_darwin's v06/1deg/input_darwin_v4r5_v2/data.darwin -- these
# files are already on the SAME LLC90 grid we use (confirmed: that
# directory's own SIZE.h has nPx=113/sNx=sNy=30/Nr=50, i.e. it's LLC90
# despite the misleading "1deg" directory name), so no Python REGRIDDING
# is needed. R_*_runoff ratios convert each runoff product into the
# darwin tracer(s) it maps to (e.g. DIN splits into NO3/NO2/NH4 fractions;
# IP maps to a fraction of dissolved + a fraction that becomes
# particulate P).
#
# FIXED: "no regridding needed, just a direct symlink" (this
# comment's original claim) was incomplete -- these fields have no
# _lon0/_nlon/etc. interpolation block (deliberately, since the source is
# already native LLC90), so darwin_exf_load.F's shared loader falls back
# to the plain MDS_READ_FIELD path, which needs a genuine <prefix>.data/
# <prefix>.meta pair, not a bare symlink to the raw per-year source files
# (crashed on the first-ever run attempt: "MDS_READ_FIELD: filename:
# DOC_ECCO_V4r5.data / File does not exist"). Built via
# util/archive/build_runoff_mds.py, which concatenates each
# field's yearly source files (verified 365/366 records/year against the
# real calendar) into one combined .data plus a matching .meta -- see
# that script's own docstring. Also fixed alongside: *runoffstartdate1
# was 19920101 (matching our own archive's start) but the runoff source's
# real first record is 1991-01-01, not 1992 -- same class of bug as
# pCO2startdate1 above, same fix (match the actual source data's own
# first-record date, not an unrelated file's).
 DOCrunofffile = 'DOC_ECCO_V4r5',
 DOCrunoffstartdate1 = 19910101,
 DOCrunoffstartdate2 = 120000,
 DOCrunoffperiod     = 86400.0,
 darwin_inscal_DOCrunoff = 1,
#
 DONrunofffile = 'DON_ECCO_V4r5',
 DONrunoffstartdate1 = 19910101,
 DONrunoffstartdate2 = 120000,
 DONrunoffperiod     = 86400.0,
 darwin_inscal_DONrunoff = 1,
#
 DOPrunofffile = 'DOP_ECCO_V4r5',
 DOPrunoffstartdate1 = 19910101,
 DOPrunoffstartdate2 = 120000,
 DOPrunoffperiod     = 86400.0,
 R_DOFe_DOP_runoff   = 3E-4,
 darwin_inscal_DOPrunoff = 1,
#
 DINrunofffile = 'DIN_ECCO_V4r5',
 DINrunoffstartdate1 = 19910101,
 DINrunoffstartdate2 = 120000,
 DINrunoffperiod     = 86400.0,
 R_NO3_DIN_runoff    = 0.6531,
 R_NO2_DIN_runoff    = 0.0158,
 R_NH4_DIN_runoff    = 0.3311,
 darwin_inscal_DINrunoff = 1,
#
 IPrunofffile = 'DIP_ECCO_V4r5',
 IPrunoffstartdate1 = 19910101,
 IPrunoffstartdate2 = 120000,
 IPrunoffperiod     = 86400.0,
 R_DFe_DIP_runoff   = 3E-4,
 R_DIP_IP_runoff    = 0.25,
 darwin_inscal_IPrunoff = 1,
#
 DSirunofffile = 'DSi_ECCO_V4r5',
 DSirunoffstartdate1 = 19910101,
 DSirunoffstartdate2 = 120000,
 DSirunoffperiod     = 86400.0,
 darwin_inscal_DSirunoff = 1,
#
 POCrunofffile = 'POC_ECCO_V4r5',
 POCrunoffstartdate1 = 19910101,
 POCrunoffstartdate2 = 120000,
 POCrunoffperiod     = 86400.0,
 darwin_inscal_POCrunoff = 1,
#
 POPrunofffile = 'PP_ECCO_V4r5',
 POPrunoffstartdate1 = 19910101,
 POPrunoffstartdate2 = 120000,
 POPrunoffperiod     = 86400.0,
 R_POFe_POP_runoff   = 3E-4,
 darwin_inscal_POPrunoff = 1,
#
 PONrunofffile = 'PN_ECCO_V4r5',
 PONrunoffstartdate1 = 19910101,
 PONrunoffstartdate2 = 120000,
 PONrunoffperiod     = 86400.0,
 darwin_inscal_PONrunoff = 1,
#
 DICrunofffile = 'DIC_ECCO_V4r5',
 DICrunoffstartdate1 = 19910101,
 DICrunoffstartdate2 = 120000,
 DICrunoffperiod     = 86400.0,
 R_ALK_DIC_runoff    = 0.9886,
 darwin_inscal_DICrunoff = 1,
#
# darwin_useEXFwind/darwin_useQsw/darwin_useSEAICE deliberately NOT copied
# from ecco_darwin's file (they sit right next to the runoff block there):
# darwin_readparms.F has hard checks --
# "IF (DARWIN_haveIce .AND. DARWIN_useSEAICE) THEN ... STOP" and the same
# pattern for haveWind/useEXFwind -- that fire a fatal ABNORMAL END if both
# a prescribed file (icefile/windFile, which we set) AND the corresponding
# use*=T flag are set together. ecco_darwin's own config has no icefile/
# windFile at all (it gets both from its own compiled pkg/seaice/pkg/exf
# instead), so useSEAICE/useEXFwind=T is correct THERE and would be a
# guaranteed crash HERE.
#
# ADDED: hydrothermal vent iron source.
# Requires DARWIN_ALLOW_HYDROTHERMAL_VENTS, now #define'd in
# code_darwin_offline/DARWIN_OPTIONS.h -- a COMPILE-TIME flag, unlike
# most fixes this session, so this needs a rebuild before its next run,
# not just a namelist change. File/period/scale copied verbatim from
# ecco_darwin's real GoM/llc90 (same grid as this port) and
# v06/llc270/input_darwin configs -- both use the identical recipe, so
# this isn't a guess. Fe flux itself is Fe = solFeVent*R_FeHe3_vent*ventHe3
# (darwin_forcing.F), applied below depthFeVent in the bottom cell only
# (darwin_check.F derives the level index from depthFeVent internally, so
# it's grid/level-count-agnostic -- no LLC90-50-level-specific tuning
# needed, unlike most of this port's other depth-dependent parameters).
# solFeVent/R_FeHe3_vent/depthFeVent are left at their compiled-in
# defaults (darwin_read_params.F: 2D-3, 4.5D8 mol Fe/mol He3, 750 m --
# Tagliabue et al. 2014) since neither real reference config overrides
# them either.
# ventHe3Period=-12. is this file's OWN already-established monthly-
# climatology convention (see ironPeriod/windPeriod above) -- no
# ventHe3startdate needed, matching both real reference configs (neither
# sets one for this field, unlike pCO2/BGC-runoff which do).
# STILL NEEDED: the actual mitgcm_3he_flux.bin file -- not in the
# ecco_darwin git repo (binary data), not yet located on Pleiades. See
# readme.txt.
 ventHe3File = 'mitgcm_3he_flux.bin',
 ventHe3Period = -12.,
 darwin_inscal_ventHe3 = 1000.,
 /
########################
# BUG FOUND AND FIXED: iron_lon0/pCO2_lon0/etc. (added earlier
# this session) were placed inside &DARWIN_FORCING_PARAMS above, but
# darwin_exf_readparms.F declares them under a SEPARATE
# NAMELIST/darwin_interp_params/ group, read via its own
# "READ(UNIT=iUnit, NML=darwin_interp_params)" immediately after the
# forcing-params read (both from this same data.darwin file, in order --
# confirmed directly from source). A variable placed in the wrong namelist
# group is a hard Fortran read error, not a silently-ignored value -- this
# would have failed at startup. Moved below into their own block, which
# also matches ecco_darwin's own file structure (it keeps
# &DARWIN_INTERP_PARAMS separate too). This block is only ever read at all
# if USE_EXF_INTERPOLATION is defined (also fixed today, in
# code_darwin_offline/EXF_OPTIONS.h) -- the two bugs had to be fixed
# together, since fixing only one would still have left the other broken.
 &DARWIN_INTERP_PARAMS
 iron_lon0    = 0.,
 iron_lon_inc = 2.5,
 iron_lat0    = -90.,
 iron_lat_inc = 95*1.894736842105263,
 iron_nlon    = 144,
 iron_nlat    = 96,
#
 pCO2_lon0    = 0.0D0,
 pCO2_lon_inc = 360.0D0,
 pCO2_lat0    = -89.4628220D0,
 pCO2_lat_inc = 0.6958694,0.6999817,0.7009048,0.7012634,0.7014313,
                245*0.7017418,
                0.7014313,0.7012634,0.7009048,0.6999817,0.6958694,
 pCO2_nlon    = 2,
 pCO2_nlat    = 256,
#
# ventHe3: same 128x64 global grid ecco_darwin's real GoM/llc90 and
# v06/llc270 configs both use for mitgcm_3he_flux.bin (copied verbatim,
# not independently derived) -- interpolated at runtime onto this run's
# own xC/yC same as iron/pCO2 above, no Python pre-regridding needed.
 ventHe3_lon0    = 1.40625,
 ventHe3_lon_inc = 2.8125,
 ventHe3_lat0    = -88.59375,
 ventHe3_lat_inc = 63*2.8125,
 ventHe3_nlon    = 128,
 ventHe3_nlat    = 64,
#
# Runoff interpMethod=0 (not the code's own default of 1): these files
# already match this run's own LLC90 grid exactly, so no real
# interpolation is needed -- matches ecco_darwin's own setting for the
# same reason (their run is on this same grid too). lon0/lat0/nlon/nlat
# are deliberately left unset for every runoff field, exactly as
# ecco_darwin's own file does: darwin_exf_readparms.F defaults them to
# inp_gNx/inp_gNy (the model's own native grid dimensions), which is
# already correct for files that match the model grid directly.
 DOCrunoff_interpMethod = 0,
 DONrunoff_interpMethod = 0,
 DOPrunoff_interpMethod = 0,
 DINrunoff_interpMethod = 0,
 IPrunoff_interpMethod = 0,
 DSirunoff_interpMethod = 0,
 POCrunoff_interpMethod = 0,
 POPrunoff_interpMethod = 0,
 PONrunoff_interpMethod = 0,
 DICrunoff_interpMethod = 0,
 /
