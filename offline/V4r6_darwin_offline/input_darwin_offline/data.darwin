 grp_prey(:)=            1, 1, 1, 1,  1,  1, 1,
 grp_hasSi(:)=           0, 0, 0, 0,  1,  0, 0,
 grp_hasPIC(:)=          1, 1, 1, 1,  1,  0, 0,
 grp_DIAZO(:)=           0, 0, 0, 1,  0,  0, 0,
 grp_useNH4(:)=          1, 1, 1, 1,  1,  1, 0,
 grp_useNO2(:)=          1, 1, 1, 1,  1,  1, 0,
