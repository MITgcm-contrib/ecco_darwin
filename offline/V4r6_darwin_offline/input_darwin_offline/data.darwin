 PARmin= 0.1,
 alpfe= 1.00,
 freefemax = .1E-3,
 depthfesed= 7000.,
 scav_tau= 1.0,
 scav_inter=9.14351851851E-7,
 scav_psi_wgt=0.0000000000E0,
 scav_pic_wgt=0.0000000000E0,
 scav_poc_wgt=0.06,
#scav_r_poppoc=0.786161635,
 kdoc=  2.314814814814815E-7,   ! 1/50day
 kdop=  2.893500000000000E-7,   ! 1/50day
 kdon=  2.314814814814815E-7,   ! 1/50day
 kdofe= 2.314814814814815E-7,   ! 1/50day
 kPOC=  3.8580246913580247E-7,  ! 1/30day
 kPOP=  4.8225000000000000E-7,  ! 1/30day
