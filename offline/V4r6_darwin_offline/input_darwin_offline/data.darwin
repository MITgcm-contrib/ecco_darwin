 &DARWIN_RADTRANS_PARAMS
# Not gridded (wavelength-indexed spectral tables, not lon/lat
# fields) -- no regridding needed, just needs to be copied/symlinked.
#
# RESOLVED: Steph delivered these (steph_input/optics/), real
# files checked directly -- all 3 cover the same 13 wavebands 400-700nm
# as RT_wbRefWLs (data.radtrans), consistent header/column format.
# optics_plankton.txt is the much larger per-species allometric table
# (darwin_allomSpectra=T in DARWIN_OPTIONS.h): repeated blocks of a cell-
# diameter header row + 13 waveband rows, one block per reference species
# -- matches the format pkg/darwin's own reader expects for that switch.
# Bare filenames below, same convention as every other symlinked-in file
# (readme.txt Part 7): ln -sf steph_input/optics/optics_*.txt into
# run_offline_llc90/.
 darwin_waterabsorbFile='optics_water.txt',
 darwin_phytoabsorbFile='optics_plankton.txt',
 darwin_particleabsorbFile='optics_detritus.txt',
 darwin_Sdom=0.0145000,
 darwin_aCDOM_fac = 0.30,
 darwin_part_size_P = 5e-17,
 darwin_rCDOM = 120.0e-4,
 darwin_RPOC = 2.0,

 darwin_allomSpectra= T,
 darwin_absorpSlope= -0.075,
 darwin_bbbSlope=    -1.458,
 darwin_scatSwitchSizeLog= 2.860959e-01, 2.923177e-01, 2.983251e-01, 3.140574e-01, 3.261153e-01,
                           3.440134e-01, 3.577670e-01, 3.618763e-01, 3.695100e-01, 3.718916e-01,
                           3.706202e-01, 3.640583e-01, 3.682107e-01,
 darwin_scatSlopeSmall= 4.185404e+00, 4.208007e+00, 4.261307e+00, 4.302451e+00, 4.341968e+00,
                        4.373109e+00, 4.392320e+00, 4.416705e+00, 4.434653e+00, 4.454953e+00,
                        4.479809e+00, 4.507577e+00, 4.544071e+00,
 darwin_scatSlopeLarge= 1.723153e+00, 1.718186e+00, 1.699666e+00, 1.687533e+00, 1.710736e+00,
                        1.732242e+00, 1.763117e+00, 1.811451e+00, 1.834619e+00, 1.863836e+00,
                        1.897289e+00, 1.861866e+00, 1.907367e+00,
 /
