# Carried over from Steph's original 1-deg set-up (data.diagnostics),
# unchanged -- this file was missing entirely from the LLC90 port until now
# (found while auditing what's still needed before the offline run can
# actually go). Every entry here is grid-independent (tracer/diagnostic
# names and record indices, not lon/lat/grid content), so nothing needed
# adjusting the way data/data.ptracers/etc. did.
#
# frequency values (e.g. 31104000.) are in seconds and come from Steph's
# original 360-day-year convention (31104000/86400 = 360 days) -- they
# still work fine as plain output-cadence values under our real Gregorian
# calendar (~a bit short of one real year), since nothing here depends on
# the calendar being 360-day the way TheCalendar itself would.
#
# CORRECTION: this header originally claimed every entry here
# was grid-independent so "nothing needed adjusting" -- true for grid, but
# not for which PACKAGES are compiled. KPPhbl (below) is pkg/kpp's own
# diagnostic and crashed the first-ever run attempt since pkg/kpp isn't
# compiled in this port (GGL90 replaced it). Worth re-checking this file
# for any other package-specific diagnostic names before assuming the
# rest is safe just because the grid checked out.
#
# Gud diagnostics
# ==================
# PAR                 Photosynthetically active radiation
# PP                  Primary production
# Nfix                Nitrogen fixation
# Rstar01             Rstar^PO4 of Phy01
# Diver1              # Phy species over absolute threshold'
# Diver2              # Phy species over threshold for proportion of biomass'
# Diver3              # Phy species constituting bulk of biomass'
# Diver4              # Phy species over threshold for ratio to maximum species'
#
 &diagnostics_list
#
# FIXED: no diagnostic output files were appearing at all -- a full 1-year
# test run produced zero biomass_c/PP/GROW/etc. files despite crossing
# frequency(1)=31104000s at iteration 8640.
# Root cause confirmed against pkg/diagnostics/diagnostics_readparms.F:
# diag_mnc defaults to useMNC (line "diag_mnc = useMNC", before this
# namelist is even read) and nothing here ever overrode it. data.pkg's
# useMNC=.TRUE. (added for the single-file archive/pickup convention) was
# silently flipping diag_mdsio off too -- "diag_mdsio = (.NOT.diag_mnc) .OR.
# outputTypesInclusive" -- so every diagnostics_list stream was writing (or
# attempting to write) NetCDF via MNC instead of the .data/.meta files this
# project actually reads (see this repo's CLAUDE.md: "Diagnostics are
# mdsio, not NetCDF"). Pin it explicitly rather than inherit useMNC's value.
  diag_mnc = .FALSE.,
#
  filename( 1) = 'biomass_c',
# frequency(1) = 2592000.,
  frequency(1) = 31104000.,
# frequency(1) = 155520000.,
  fields( 1,1) = 'TRAC01  ',
  fields( 2,1) = 'TRAC02  ',
  fields( 3,1) = 'TRAC03  ',
  fields( 4,1) = 'TRAC04  ',
  fields( 5,1) = 'TRAC05  ',
  fields( 6,1) = 'TRAC06  ',
  fields( 7,1) = 'TRAC07  ',
  fields( 8,1) = 'TRAC08  ',
  fields( 9,1) = 'TRAC09  ',
  fields(10,1) = 'TRAC10  ',
  fields(11,1) = 'TRAC11  ',
  fields(12,1) = 'TRAC12  ',
  fields(13,1) = 'TRAC13  ',
  fields(14,1) = 'TRAC14  ',
  fields(15,1) = 'TRAC15  ',
  fields(16,1) = 'TRAC16  ',
  fields(17,1) = 'TRAC17  ',
  fields(18,1) = 'TRAC18  ',
  fields(19,1) = 'TRAC19  ',
  fields(20,1) = 'TRAC20  ',
  fields(21,1) = 'TRAC21  ',
  fields(22,1) = 'TRAC22  ',
  fields(23,1) = 'TRAC23  ',
  fields(24,1) = 'TRAC24  ',
  fields(25,1) = 'TRAC25  ',
  fields(26,1) = 'TRAC26  ',
  fields(27,1) = 'TRAC27  ',
  fields(28,1) = 'TRAC28  ',
  fields(29,1) = 'TRAC29  ',
  fields(30,1) = 'TRAC30  ',
  fields(31,1) = 'TRAC31  ',
  fields(32,1) = 'TRAC32  ',
  fields(33,1) = 'TRAC33  ',
  fields(34,1) = 'TRAC34  ',
  fields(35,1) = 'TRAC35  ',
  fields(36,1) = 'TRAC36  ',

  filename( 3) = 'General_2d',
  frequency(3) = 31104000.,
# frequency(3) = 2592000.,
  fields(1,3) = 'surfPAR ',
  fields(2,3) = 'DARice  ',
  fields(3,3) = 'MXLDEPTH',
# fields(4,3) = 'KPPhbl  ', ! FIXED: KPPhbl is pkg/kpp's own
# boundary-layer-depth diagnostic -- pkg/kpp isn't compiled here (GGL90
# replaced it, see code_darwin_offline/packages.conf), so this crashed
# with "DIAGNOSTICS_SET_POINTERS: KPPhbl is not a Diagnostic" on the
# first-ever run attempt. No GGL90 equivalent exists (GGL90 is a
# TKE-mixing scheme, not a boundary-layer-depth calculation) -- dropped
# outright rather than guessing a replacement name, matching how
# PTRACERS_useKPP was already handled. MXLDEPTH above (grid/scheme-
# independent mixed-layer depth) already covers the same physical role.

 filename(4)='PP',
 frequency(4) = 31104000.,
#frequency(4) = 2592000.,
  fields(  1,4 ) = 'PP0001  ',
