 &PTRACERS_PARM01
 PTRACERS_numInUse= 36,
 PTRACERS_Iter0= 0,
#
 PTRACERS_advScheme(:)= 36*33,
 PTRACERS_diffKh(:)= 36*0.0,
 PTRACERS_diffKr(:)= 36*1D-05,
 PTRACERS_useGMRedi(:)= 36*.TRUE.,
# PTRACERS_useKPP dropped: pkg/kpp is no longer compiled (replaced by
# GGL90 -- see code_darwin_offline/packages.conf). It was declared
# unconditionally in PTRACERS_PARAMS.h so leaving it wouldn't break
# the namelist read, but it would be a misleading dead value implying
# KPP is still active. GGL90's mixing is not gated per-tracer the way
# KPP's was -- it folds into the same shared KappaRx vertical
# diffusivity every tracer already receives, unconditionally.
#
 PTRACERS_names(  1)= 'DIC',
 PTRACERS_names(  2)= 'NO3',
 PTRACERS_names(  3)= 'NO2',
 PTRACERS_names(  4)= 'NH4',
 PTRACERS_names(  5)= 'PO4',
 PTRACERS_names(  6)= 'FeT',
 PTRACERS_names(  7)= 'SiO2',
 PTRACERS_names(  8)= 'DOC',
 PTRACERS_names(  9)= 'DON',
 PTRACERS_names( 10)= 'DOP',
 PTRACERS_names( 11)= 'DOFe',
 PTRACERS_names( 12)= 'POC',
 PTRACERS_names( 13)= 'PON',
 PTRACERS_names( 14)= 'POP',
 PTRACERS_names( 15)= 'POFe',
 PTRACERS_names( 16)= 'POSi',
 PTRACERS_names( 17)= 'PIC',
 PTRACERS_names( 18)= 'ALK',
 PTRACERS_names( 19)= 'O2',
 PTRACERS_names( 20)= 'CDOM',
 PTRACERS_names( 21)= 'c01',
 PTRACERS_names( 22)= 'c02',
