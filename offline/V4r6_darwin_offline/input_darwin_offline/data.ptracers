 PTRACERS_units( 30)= 'mmol C/m^3'
 PTRACERS_units( 31)= 'mg Chl a/m^3'
 PTRACERS_units( 32)= 'mg Chl a/m^3'
 PTRACERS_units( 33)= 'mg Chl a/m^3'
 PTRACERS_units( 34)= 'mg Chl a/m^3'
 PTRACERS_units( 35)= 'mg Chl a/m^3'
 PTRACERS_units( 36)= 'mg Chl a/m^3'
#
# Regridded by run_regrid_steph_ics.py (regrid_to_llc90.py's real
# pipeline, run on Steph's actual delivered files under steph_input/ICs/).
# Every path below is a bare filename -- readme.txt Part 7 symlinks
# regridded_llc90/* into the run directory, same convention as the mitgrid
# files. Trailing comments give the original 1x1-degree source filename for
# traceability.
#
# REVERTED: tracers 21-26 (c01-c06, the 6 photosynthetic groups)
# briefly had NO PTRACERS_initialFile, cold-
# starting at PTRACERS_ref=0.0 -- meant to force Chl01-06 (tracers 31-36)
# to zero too, since darwin_init_chl.F unconditionally recomputes Chl at
# cold start as chltmp=MAX(carbon*chl2cmin,...) and zeroing carbon was the
# only lever that reached exactly zero. This had a serious, unintended
# side effect, only caught by actually running the model: growth/uptake in
# darwin_plankton.F is purely multiplicative (every term scales with the
# group's own existing biomass X(j)), so a group cold-started at EXACTLY
# zero can never grow -- confirmed empirically (still bit-exact zero after
# 120 real hours of integration in the first test run) and confirmed
# against source (every uptake term is "...*X(j)"). c01-c06 would have
# stayed at zero for the entire 34-year run, not just at t=0.
#
# Root confusion: Steph's own convention (confirmed directly,)
# is that Chl starts with NO file (implicit 0 in the namelist), but the
# ACTUAL runtime cold-start value is never literally zero -- it's
# immediately "instant-acclimated" via that same chltmp formula, using
# REAL nonzero biomass. Her own data.ptracers uses the SAME
# biomass_run33_4_28800.bin restart for ALL 10 plankton tracers (21-30),
# not just the 4 Zoo ones -- zeroing c01-c06's carbon was never her
# practice. Reverted to match: c01-c06 get the same real biomass restart
# c07-c10 already used, Chl01-06 keep no initial file (matching Steph's
# convention exactly -- their real cold-start value now comes from
# genuine acclimation against nonzero biomass, not a forced zero).
#
# Tracers 1 and 18 (DIC, ALK) SWITCHED from
# 1-degree GLODAP climatologies to real LLC270-native fields
# (steph_input/v06/ICs/), regridded via regrid_llc270_to_llc90
# (nearest-wet-neighbor on the native cube-sphere grid -- see
# regrid_to_llc90.py's LLC270 section and run_regrid_v06_llc270_ics.py).
# Only these two come from that directory: NO3/PO4/FeT/SiO2/O2 were also
# briefly switched to LLC270 sources from it, then reverted. Those five
# stay on Steph's
# 1-degree files below, unchanged from the original port.
 PTRACERS_initialFile(  1)= 'DIC_llc270_to_llc90.bin',                 ! steph_input/v06/ICs/DIC.R4_270x3510x50.bin
 PTRACERS_initialFile(  2)= 'lev01_nitrate_ann-3d_llc90.bin',           ! lev01_nitrate_ann-3d.bin
 PTRACERS_initialFile(  3)= 'ptr03_run33_4_28800_llc90.bin',           ! ptr03_run33_4_28800.bin
 PTRACERS_initialFile(  4)= 'ptr04_run33_4_28800_llc90.bin',           ! ptr04_run33_4_28800.bin
 PTRACERS_initialFile(  5)= 'lev01_phosphate_ann-3d_llc90.bin',        ! lev01_phosphate_ann-3d.bin
 PTRACERS_initialFile(  6)= 'ptr06_run33_4_28800_llc90.bin',           ! ptr06_run33_4_28800.bin
 PTRACERS_initialFile(  7)= 'lev01_silicate_ann-3d_llc90.bin',         ! lev01_silicate_ann-3d.bin
 PTRACERS_initialFile(  8)= 'ptr08_run33_4_28800_llc90.bin',           ! ptr08_run33_4_28800.bin
 PTRACERS_initialFile(  9)= 'ptr09_run33_4_28800_llc90.bin',           ! ptr09_run33_4_28800.bin
 PTRACERS_initialFile( 10)= 'ptr10_run33_4_28800_llc90.bin',           ! ptr10_run33_4_28800.bin
 PTRACERS_initialFile( 11)= 'ptr11_run33_4_28800_llc90.bin',           ! ptr11_run33_4_28800.bin
 PTRACERS_initialFile( 12)= 'ptr12_run33_4_28800_llc90.bin',           ! ptr12_run33_4_28800.bin
 PTRACERS_initialFile( 13)= 'ptr13_run33_4_28800_llc90.bin',           ! ptr13_run33_4_28800.bin
 PTRACERS_initialFile( 14)= 'ptr14_run33_4_28800_llc90.bin',           ! ptr14_run33_4_28800.bin
 PTRACERS_initialFile( 15)= 'ptr15_run33_4_28800_llc90.bin',           ! ptr15_run33_4_28800.bin
 PTRACERS_initialFile( 16)= 'ptr16_run33_4_28800_llc90.bin',           ! ptr16_run33_4_28800.bin
 PTRACERS_initialFile( 17)= 'ptr17_run33_4_28800_llc90.bin',           ! ptr17_run33_4_28800.bin
 PTRACERS_initialFile( 18)= 'ALK_llc270_to_llc90.bin',                 ! steph_input/v06/ICs/ALK.R4_270x3510x50.bin
 PTRACERS_initialFile( 19)= 'lev01_oxygen_micromolar_ann-3d_llc90.bin',! lev01_oxygen_micromolar_ann-3d.bin
 PTRACERS_initialFile( 20)= 'ptr20_run33_4_28800_llc90.bin',           ! ptr20_run33_4_28800.bin
 PTRACERS_initialFile( 21: 30)= 10*'biomass_run33_4_28800_llc90.bin',  ! biomass_run33_4_28800.bin
 /
