# Diagnostic Package Choices
#-----------------
# for each output-stream:
#  filename(n) : prefix of the output file name (only 8.c long) for outp.stream n
#  frequency(n):< 0 : write snap-shot output every multiple of |frequency| (iter)
#               > 0 : write time-average output every multiple of frequency (iter)
#  levels(:,n) : list of levels to write to file (Notes: declared as REAL)
#                 when this entry is missing, select all common levels of this list
#  fields(:,n) : list of diagnostics fields (8.c) (see "available_diagnostics" file
#                 for the list of all available diag. in this particular config)
#--------------------------------------------------------------------
#
# Minimal OAEMIP-only diagnostics file: exactly one stream per protocol
# variable in oaemip_variable_table.m (Table 1 monthly + Table 2 daily),
# nothing else. No bonus/QC fields (PAR, PP, CO3, fugfCO2, virtual fluxes,
# per-group Chl, sea ice thickness, wind speed, full-3D pCO2/pH/OmegaC,
# etc.) -- add those back separately if you want them for your own science,
# they are not part of the delivery.
#
# NOTE: ALKinj / C_ALKNO3 / C_ALKPIC (your own OAE injection diagnostics)
# are also NOT protocol variables and were removed from this file per the
# same rule. They are not duplicated anywhere else -- if you still want
# them tracked (e.g. to verify injection timing/magnitude), let me know
# and I'll add them back as a clearly-separate non-protocol block.
#
 &diagnostics_list
#
  dumpatlast = .TRUE.,
#
#=====================================================================
# MONTHLY DIAGNOSTICS (frequency = 2635200 s ~ 1 month) -- Table 1
#=====================================================================
#---
  frequency(1) = 2635200.,
   fields(1,1) = 'fluxCO2 ',
   filename(1) = 'diags/monthly/CO2_flux',
#--- fgco2
  frequency(2) = 2635200.,
   fields(1,2) = 'pCO2    ',
   levels(1,2) = 1.,
   filename(2) = 'diags/monthly/pCO2',
#--- spco2
  frequency(3) = 2635200.,
   fields(1,3) = 'SIarea  ',
   filename(3) = 'diags/monthly/SIarea',
#--- fice
  frequency(4) = 2635200.,
   fields(1,4) = 'Kw      ',
   filename(4) = 'diags/monthly/Kw',
#--- Kw
  frequency(5) = 2635200.,
   fields(1,5) = 'apCO2   ',
   filename(5) = 'diags/monthly/apCO2',
#--- pco2atm
  frequency(6) = 2635200.,
   fields(1,6) = 'alphaCO2',
   filename(6) = 'diags/monthly/alphaCO2',
#--- alpha
  frequency(7) = 2635200.,
   fields(1,7) = 'THETA   ',
   levels(1,7) = 1.,
   filename(7) = 'diags/monthly/SST',
#--- tos
  frequency(8) = 2635200.,
   fields(1,8) = 'SALT    ',
   levels(1,8) = 1.,
   filename(8) = 'diags/monthly/SSS',
#--- sos
  frequency(9) = 2635200.,
   fields(1,9) = 'pH      ',
   levels(1,9) = 1.,
   filename(9) = 'diags/monthly/pH',
#--- phos
  frequency(10) = 2635200.,
   fields(1,10) = 'OmegaC  ',
   levels(1,10) = 1.,
   filename(10) = 'diags/monthly/OmegaC',
#--- omegacalc
  frequency(11) = 2635200.,
   fields(1,11) = 'OmegaAr ',
   levels(1,11) = 1.,
   filename(11) = 'diags/monthly/OmegaAr',
#--- omegaarag
  frequency(12) = 2635200.,
   fields(1,12) = 'Chl     ',
   levels(1,12) = 1.,
   filename(12) = 'diags/monthly/Chl_surf',
#--- chlos
  frequency(13) = 2635200.,
   fields(1,13) = 'TRAC02  ',
   levels(1,13) = 1.,
   filename(13) = 'diags/monthly/NO3',
#--- no3os
  frequency(14) = 2635200.,
   fields(1,14) = 'TRAC05  ',
   levels(1,14) = 1.,
   filename(14) = 'diags/monthly/PO4',
#--- po4os
  frequency(15) = 2635200.,
   fields(1,15) = 'TRAC07  ',
   levels(1,15) = 1.,
   filename(15) = 'diags/monthly/SiO2',
#--- sios
  frequency(16) = 2635200.,
   fields(1,16) = 'MXLDEPTH',
   filename(16) = 'diags/monthly/mldDepth',
#--- mld
  frequency(17) = 2635200.,
   fields(1,17) = 'TRAC01  ',
   filename(17) = 'diags/monthly/DIC',
#--- dissic (full 3D; dissicos slices level 1 from this same file)
  frequency(18) = 2635200.,
   fields(1,18) = 'TRAC18  ',
   filename(18) = 'diags/monthly/ALK',
#--- talk (full 3D; talkos slices level 1 from this same file)
  frequency(19) = 2635200.,
   fields(1,19) = 'TRAC32  ',
   filename(19) = 'diags/monthly/ALKtr',
#--- talktracer
  frequency(20) = 2635200.,
   fields(1,20) = 'THETA   ',
   filename(20) = 'diags/monthly/THETA',
#--- thetao (full 3D)
  frequency(21) = 2635200.,
   fields(1,21) = 'SALT    ',
   filename(21) = 'diags/monthly/SALT',
#--- so (full 3D)
  frequency(22) = 2635200.,
   fields(1,22) = 'UE_VEL_C',
   filename(22) = 'diags/monthly/uVel_C',
#--- uvel
  frequency(23) = 2635200.,
   fields(1,23) = 'VN_VEL_C',
   filename(23) = 'diags/monthly/vVel_C',
#--- vvel
  frequency(24) = 2635200.,
   fields(1,24) = 'WVEL    ',
   filename(24) = 'diags/monthly/wVel',
#--- wvel
#
#=====================================================================
# DAILY DIAGNOSTICS (frequency = 86400 s = 1 day) -- Table 2
# (first 5 years of OAE; enable/disable this block per restart segment
#  if you only want it written during that window)
#=====================================================================
#---
  frequency(25) = 86400.,
   fields(1,25) = 'fluxCO2 ',
   filename(25) = 'diags/daily/CO2_flux',
#--- fgco2
  frequency(26) = 86400.,
   fields(1,26) = 'pCO2    ',
   levels(1,26) = 1.,
   filename(26) = 'diags/daily/pCO2',
#--- spco2
  frequency(27) = 86400.,
   fields(1,27) = 'Kw      ',
   filename(27) = 'diags/daily/Kw',
#--- Kw
  frequency(28) = 86400.,
   fields(1,28) = 'apCO2   ',
   filename(28) = 'diags/daily/apCO2',
#--- pco2atm
  frequency(29) = 86400.,
   fields(1,29) = 'alphaCO2',
   filename(29) = 'diags/daily/alphaCO2',
#--- alpha
  frequency(30) = 86400.,
   fields(1,30) = 'THETA   ',
   levels(1,30) = 1.,
   filename(30) = 'diags/daily/SST',
#--- tos
  frequency(31) = 86400.,
   fields(1,31) = 'SALT    ',
   levels(1,31) = 1.,
   filename(31) = 'diags/daily/SSS',
#--- sos
  frequency(32) = 86400.,
   fields(1,32) = 'MXLDEPTH',
   filename(32) = 'diags/daily/mldDepth',
#--- mld
  frequency(33) = 86400.,
   fields(1,33) = 'TRAC01  ',
   levels(1,33) = 1.,
   filename(33) = 'diags/daily/DIC',
#--- dissicos
  frequency(34) = 86400.,
   fields(1,34) = 'TRAC18  ',
   levels(1,34) = 1.,
   filename(34) = 'diags/daily/ALK',
#--- talkos
#
 &

 /

# Parameter for Diagnostics of per level statistics:
#-----------------
# for each output-stream:
#  stat_fname(n) : prefix of the output file name (only 8.c long) for outp.stream n
#  stat_freq(n):< 0 : write snap-shot output every |stat_freq| seconds
#               > 0 : write time-average output every stat_freq seconds
#  stat_phase(n)    : write at time = stat_phase + multiple of |stat_freq|
#  stat_region(:,n) : list of "regions" (default: 1 region only=global)
#  stat_fields(:,n) : list of diagnostics fields (8.c) (see "available_diagnostics.log"
#                 file for the list of all available diag. in this particular config)
#-----------------
 &DIAG_STATIS_PARMS

 /

